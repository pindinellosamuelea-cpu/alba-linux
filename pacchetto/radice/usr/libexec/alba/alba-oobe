    @staticmethod
    def _anteprima(w, cr, colori):
        fondo, finestra, testo = (Gdk.RGBA() for _ in range(3))
        for c, v in zip((fondo, finestra, testo), colori):
            c.parse(v)
        L, A = w.get_allocated_width(), w.get_allocated_height()

        def tondo(x, y, l, a, r):
            cr.new_sub_path()
            for cx, cy, ang in ((x + l - r, y + r, -90), (x + l - r, y + a - r, 0), (x + r, y + a - r, 90),
                                (x + r, y + r, 180)):
                cr.arc(cx, cy, r, ang * 3.14159 / 180, (ang + 90) * 3.14159 / 180)
            cr.close_path()
        Gdk.cairo_set_source_rgba(cr, fondo)
        tondo(0, 0, L, A, 12)
        cr.fill()
        Gdk.cairo_set_source_rgba(cr, finestra)
        tondo(18, 16, L - 36, A - 40, 8)
        cr.fill()
        cr.set_source_rgb(1.0, 0.54, 0.30)
        tondo(30, 28, 50, 8, 4)
        cr.fill()
        Gdk.cairo_set_source_rgba(cr, testo)
        for i in range(3):
            tondo(30, 46 + i * 12, L - 90 - i * 20, 5, 2.5)
            cr.fill()
        cr.set_source_rgba(0.12, 0.12, 0.17, 1)
        tondo(0, A - 16, L, 16, 6)
        cr.fill()

    def _tema(self, chiave, bottone):
        if not bottone.get_active():
            if not any(b.get_active() for b in self.tessere.values()):
                bottone.set_active(True)
            return
        self.scelte["tema"] = chiave
        for k, b in self.tessere.items():
            if k != chiave and b.get_active():
                b.set_active(False)

