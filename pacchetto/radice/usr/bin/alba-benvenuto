#!/usr/bin/python3
"""Alba Linux - finestra di benvenuto."""
import os
import shutil
import subprocess
import sys

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GdkPixbuf  # noqa: E402

CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "alba")
NO_AVVIO = os.path.join(CONF, "nascondi-benvenuto")
IN_LIVE = os.path.isdir("/run/live/medium")
LOGO = "/usr/share/icons/hicolor/scalable/apps/alba-logo.svg"

CSS = b"""
#testata {
  background-image: linear-gradient(120deg, #131833 0%, #2a2350 55%, #6b3a5a 85%, #e86a3a 130%);
  padding: 28px 32px;
}
#titolo { color: #ffffff; font-size: 26px; font-weight: 800; }
#sottotitolo { color: #ffd7c2; font-size: 13px; }
.scheda {
  border-radius: 14px; padding: 16px; border: 1px solid alpha(#888, 0.25);
  background-color: alpha(@theme_base_color, 0.9);
  transition: all 150ms ease;
}
.scheda:hover { border-color: #ff8a4c; background-color: alpha(#ff8a4c, 0.08); }
.scheda-titolo { font-weight: 700; font-size: 14px; }
.scheda-testo { font-size: 11.5px; opacity: 0.75; }
.principale { background-image: linear-gradient(135deg, #ff8a4c, #e8553a); border: none; }
.principale .scheda-titolo, .principale .scheda-testo { color: #ffffff; opacity: 1; }
"""


def avvia(*cmd):
    """Avvia il primo comando disponibile senza bloccare la finestra."""
    for c in cmd:
        if shutil.which(c[0]):
            subprocess.Popen(c, start_new_session=True)
            return
    dialogo("Funzione non disponibile su questo sistema.")


def dialogo(testo):
    d = Gtk.MessageDialog(message_type=Gtk.MessageType.INFO, buttons=Gtk.ButtonsType.OK)
    d.set_markup(testo)
    d.run()
    d.destroy()


def xfconf(canale, prop, valore):
    subprocess.run(["xfconf-query", "-c", canale, "-p", prop, "-s", valore], check=False)


def tema(scuro):
    xfconf("xsettings", "/Net/ThemeName", "Arc-Dark" if scuro else "Arc")
    xfconf("xsettings", "/Net/IconThemeName", "Papirus-Dark" if scuro else "Papirus")
    xfconf("xfwm4", "/general/theme", "Arc-Dark" if scuro else "Arc")


def info_windows():
    dialogo(
        "<b>Programmi Windows</b>\n\n"
        "Fai doppio clic su un file <b>.exe</b> o <b>.msi</b>: si apre come su Windows, "
        "senza installare altro. I programmi installati compaiono nel menu Start.\n\n"
        "La prima volta che apri un file, Alba ti mostra da dove proviene e ti permette "
        "di controllarlo con l'antivirus.\n\n"
        "Per i giochi Windows usa <b>Steam</b>: attiva Proton in Impostazioni → Compatibilità.\n\n"
        "<small>Funziona con la grande maggioranza dei programmi. Non funzionano i driver "
        "Windows e alcuni giochi con anti-cheat a livello di kernel.</small>"
    )


class Benvenuto(Gtk.Window):
    def __init__(self):
        super().__init__(title="Benvenuto in Alba")
        self.set_default_size(820, 600)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("alba-logo")

        stile = Gtk.CssProvider()
        stile.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), stile, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        corpo = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(corpo)

        # Testata
        testata = Gtk.Box(spacing=20)
        testata.set_name("testata")
        if os.path.exists(LOGO):
            pix = GdkPixbuf.Pixbuf.new_from_file_at_size(LOGO, 72, 72)
            testata.pack_start(Gtk.Image.new_from_pixbuf(pix), False, False, 0)
        testi = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        testi.set_valign(Gtk.Align.CENTER)
        t = Gtk.Label(label="Benvenuto in Alba", xalign=0)
        t.set_name("titolo")
        s = Gtk.Label(label="Semplice come Windows, libero e sicuro come Linux. Ecco da dove iniziare.", xalign=0)
        s.set_name("sottotitolo")
        testi.pack_start(t, False, False, 0)
        testi.pack_start(s, False, False, 0)
        testata.pack_start(testi, True, True, 0)
        # Il contenitore EventBox serve perché GTK disegni lo sfondo sfumato
        cornice = Gtk.EventBox()
        cornice.set_name("testata")
        testata.set_name("")
        cornice.add(testata)
        corpo.pack_start(cornice, False, False, 0)

        # Schede
        griglia = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE,
                              max_children_per_line=3, min_children_per_line=2,
                              row_spacing=12, column_spacing=12, homogeneous=True)
        griglia.set_margin_start(24)
        griglia.set_margin_end(24)
        griglia.set_margin_top(20)
        griglia.set_margin_bottom(12)

        schede = []
        if IN_LIVE:
            schede.append(("drive-harddisk", "Installa Alba",
                           "Copia Alba sul computer in pochi passaggi guidati.",
                           lambda: avvia(["install-debian"], ["pkexec", "calamares"]), True))
        schede += [
            ("video-display", "Driver grafici",
             "Controlla la scheda video e installa il driver migliore.",
             lambda: avvia(["alba-impostazioni", "--pagina", "scheda-grafica"]), False),
            ("wine", "Programmi Windows",
             "Apri i file .exe con un doppio clic. Scopri come funziona.",
             info_windows, False),
            ("org.gnome.Software", "Negozio di app",
             "Migliaia di app gratuite, installabili con un clic.",
             lambda: avvia(["gnome-software"]), False),
            ("software-update-available", "Aggiornamenti",
             "Gli aggiornamenti di sicurezza sono automatici. Qui vedi gli altri.",
             lambda: avvia(["gnome-software", "--mode=updates"]), False),
            ("security-high", "Firewall",
             "Attivo di serie: blocca le connessioni in entrata.",
             lambda: avvia(["gufw"]), False),
            ("document-save", "Punti di ripristino",
             "Salva lo stato del sistema e torna indietro se qualcosa va storto.",
             lambda: avvia(["timeshift-launcher"], ["pkexec", "timeshift-gtk"]), False),
            ("steam", "Giochi",
             "Steam con Proton, GameMode e Lutris già pronti.",
             lambda: avvia(["steam"], ["lutris"]), False),
            ("applications-graphics", "Creatività",
             "Kdenlive, Krita, GIMP, Blender, OBS: editing con la scheda grafica.",
             lambda: avvia(["kdenlive"], ["krita"], ["gimp"]), False),
            ("preferences-desktop", "Impostazioni",
             "Schermo, rete, stampanti, tastiera e tutto il resto.",
             lambda: avvia(["alba-impostazioni"]), False),
        ]
        for icona, titolo, testo, azione, principale in schede:
            griglia.add(self.scheda(icona, titolo, testo, azione, principale))
        scorri = Gtk.ScrolledWindow()
        scorri.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scorri.add(griglia)
        corpo.pack_start(scorri, True, True, 0)

        # Barra inferiore: tema e avvio automatico
        piede = Gtk.Box(spacing=12)
        piede.set_margin_start(24)
        piede.set_margin_end(24)
        piede.set_margin_bottom(16)
        piede.pack_start(Gtk.Label(label="Aspetto:"), False, False, 0)
        chiaro = Gtk.RadioButton.new_with_label(None, "Chiaro")
        scuro = Gtk.RadioButton.new_with_label_from_widget(chiaro, "Scuro")
        tema_attuale = subprocess.run(["xfconf-query", "-c", "xsettings", "-p", "/Net/ThemeName"],
                                      capture_output=True, text=True).stdout
        scuro.set_active("Dark" in tema_attuale)
        scuro.connect("toggled", lambda b: tema(b.get_active()))
        piede.pack_start(chiaro, False, False, 0)
        piede.pack_start(scuro, False, False, 0)
        mostra = Gtk.CheckButton(label="Mostra all'avvio")
        mostra.set_active(not os.path.exists(NO_AVVIO))
        mostra.connect("toggled", self.cambia_avvio)
        piede.pack_end(mostra, False, False, 0)
        corpo.pack_start(piede, False, False, 0)

    def scheda(self, icona, titolo, testo, azione, principale):
        pulsante = Gtk.Button()
        pulsante.set_relief(Gtk.ReliefStyle.NONE)
        pulsante.get_style_context().add_class("scheda")
        if principale:
            pulsante.get_style_context().add_class("principale")
        riga = Gtk.Box(spacing=14)
        riga.pack_start(Gtk.Image.new_from_icon_name(icona, Gtk.IconSize.DIALOG), False, False, 0)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        lt = Gtk.Label(label=titolo, xalign=0)
        lt.get_style_context().add_class("scheda-titolo")
        ld = Gtk.Label(label=testo, xalign=0, wrap=True, max_width_chars=26)
        ld.get_style_context().add_class("scheda-testo")
        col.pack_start(lt, False, False, 0)
        col.pack_start(ld, False, False, 0)
        riga.pack_start(col, True, True, 0)
        pulsante.add(riga)
        pulsante.connect("clicked", lambda *_: azione())
        return pulsante

    def cambia_avvio(self, casella):
        os.makedirs(CONF, exist_ok=True)
        if casella.get_active():
            if os.path.exists(NO_AVVIO):
                os.remove(NO_AVVIO)
        else:
            open(NO_AVVIO, "w").close()


if __name__ == "__main__":
    # All'avvio compare solo nella versione di prova (dalla chiavetta USB):
    # dopo l'installazione le stesse cose si trovano in Impostazioni.
    if "--avvio" in sys.argv and (not IN_LIVE or os.path.exists(NO_AVVIO)):
        sys.exit(0)
    finestra = Benvenuto()
    finestra.connect("destroy", Gtk.main_quit)
    finestra.show_all()
    Gtk.main()
