    "panel-preferences", "xfce4-screensaver-preferences", "xfce4-about",
    "thunar-settings", "thunar-volman-settings", "thunar-bulk-rename",
    "exo-preferred-applications", "xfce4-web-browser", "xfce4-mail-reader",
    "xfce4-file-manager", "xfce4-terminal-emulator", "xfce4-appfinder", "xfce4-run",
    "xfce4-dict", "xfce4-sensors", "xfce4-clipman", "xfce4-clipman-settings",
    "org.xfce.mousepad-settings", "mugshot", "display-im6*", "display-im7*",
    "avahi-discover", "bssh", "bvnc", "openjdk-*", "*-java-*", "info", "yelp",
    "org.gnome.Yelp", "reportbug", "file-roller", "org.gnome.FileRoller",
    "libreoffice-startcenter", "libreoffice-xsltfilter", "winetricks", "wine",
    "alba-impostazioni-windows", "alba-programmi-windows-installati", "lstopo",
    "vkcube", "vulkan-*", "nvidia-settings", "corectrl", "org.corectrl.CoreCtrl",
    "timeshift-gtk", "system-config-printer", "xfce4-screenshooter",
    "org.xfce.ristretto", "gcr-*", "galculator", "xsane", "mpv", "debian-*",
