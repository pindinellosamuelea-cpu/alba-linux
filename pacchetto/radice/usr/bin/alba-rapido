#!/usr/bin/python3
"""Alba Linux - menu rapidi dalla barra, come su Windows 11 e macOS.

  alba-rapido wifi        reti disponibili, collegati con un clic
  alba-rapido bluetooth   dispositivi, cerca e collega
  alba-rapido audio       volume, casse/cuffie e microfono
  alba-rapido batteria    carica, modalità di alimentazione, luminosità
  alba-rapido controlli   impostazioni rapide (tutto insieme, Super+A)
  alba-rapido notifiche   calendario, notifiche, Non disturbare
"""
import configparser
import glob
import importlib.machinery
import importlib.util
import os
import re
import sqlite3
import sys
import time

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk, Pango  # noqa: E402

# Strumenti condivisi con l'app Impostazioni
_caricatore = importlib.machinery.SourceFileLoader(
    "alba_impostazioni", os.environ.get("ALBA_IMPOSTAZIONI", "/usr/bin/alba-impostazioni"))
_spec = importlib.util.spec_from_loader("alba_impostazioni", _caricatore)
A = importlib.util.module_from_spec(_spec)
_caricatore.exec_module(A)
esegui, uscita, esiste, avvia, in_sottofondo = A.esegui, A.uscita, A.esiste, A.avvia, A.in_sottofondo
etichetta, pulsante, Interruttore = A.etichetta, A.pulsante, A.Interruttore
DEMO = A.DEMO

CSS = b"""
window.rapido { background-color: transparent; }
.scatola { background-color: @theme_bg_color; border-radius: 18px;
           border: 1px solid alpha(@theme_fg_color, 0.12); padding: 14px; }
.titolo { font-size: 13pt; font-weight: 800; }
.voce { border-radius: 10px; padding: 8px 10px; background: none; border: none; box-shadow: none; }
.voce:hover { background-color: alpha(@theme_fg_color, 0.07); }
.voce-attiva { background-color: alpha(#ff8a4c, 0.16); }
.piccolo { font-size: 9pt; opacity: 0.65; }
.notifica { background-color: alpha(@theme_fg_color, 0.05); border-radius: 12px; padding: 10px 12px; }
.ora-grande { font-size: 26pt; font-weight: 800; }
.piede button { border-radius: 8px; }
calendar { border: none; background: none; }
.tessera-rapida { border-radius: 10px; min-height: 46px; min-width: 58px; border: none; box-shadow: none;
                  background-image: none; background-color: alpha(@theme_fg_color, 0.08);
                  transition: background-color 160ms ease, -gtk-icon-transform 120ms ease; }
.tessera-rapida:hover { background-color: alpha(@theme_fg_color, 0.14); }
.tessera-rapida:active { -gtk-icon-transform: scale(0.92); }
.tessera-rapida:checked { background-color: #ff8a4c; color: #ffffff; }
.tessera-rapida:checked image { color: #ffffff; }
.freccia { min-width: 26px; padding: 0 4px; }
.nome-tessera { font-size: 9pt; }
.sotto-tessera { font-size: 8pt; opacity: 0.6; }
.barra-basso { background-color: alpha(@theme_fg_color, 0.04); border-radius: 0 0 18px 18px;
               margin: 4px -14px -14px -14px; padding: 10px 16px; }
.cursore-rapido trough { min-height: 6px; border-radius: 3px; }
.cursore-rapido highlight { background-color: #ff8a4c; border-radius: 3px; }
.cursore-rapido slider { min-width: 18px; min-height: 18px; border-radius: 9px; background-color: #ffffff;
                         border: 1px solid alpha(#000000, 0.15); }
.batteria-grande { font-size: 24pt; font-weight: 800; }
.modo-energia { border-radius: 10px; padding: 8px 4px; border: none; box-shadow: none; background-image: none;
                background-color: alpha(@theme_fg_color, 0.08); }
.modo-energia:hover { background-color: alpha(@theme_fg_color, 0.14); }
.modo-energia:checked { background-color: #ff8a4c; color: #ffffff; }
.modo-energia:checked image, .modo-energia:checked label { color: #ffffff; }
.voce-audio:checked { background-color: alpha(#ff8a4c, 0.18); }
calendar:selected { background-color: #ff8a4c; color: #ffffff; border-radius: 6px; }
"""

TACCHE = lambda s: 4 if s > 75 else 3 if s > 50 else 2 if s > 25 else 1


class Rapido(Gtk.Window):
    def __init__(self, modo):
        super().__init__(title="Alba")
        self.modo = modo
        self.get_style_context().add_class("rapido")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_resizable(False)
        visuale = self.get_screen().get_rgba_visual()
        if visuale:
            self.set_visual(visuale)
        self.set_app_paintable(True)
        stile = Gtk.CssProvider()
        stile.load_from_data(A.CSS + CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), stile,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.scatola = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.scatola.get_style_context().add_class("scatola")
        self.scatola.set_size_request(380, -1)
        self.contenitore = self.scatola
        self.indietro = None
        # Animazione di apertura: il pannello sale dal basso
        self.rivela = Gtk.Revealer()
        self.rivela.set_transition_type(Gtk.RevealerTransitionType.SLIDE_UP)
        self.rivela.set_transition_duration(220)
        self.rivela.add(self.scatola)
        self.add(self.rivela)
        self.connect("focus-out-event", lambda *_: self._chiudi_presto())
        self.connect("key-press-event", lambda w, e: self.destroy() if e.keyval == Gdk.KEY_Escape else None)
        getattr(self, f"costruisci_{modo.replace('-', '_')}")()
        self.show_all()
        self._posiziona()
        self.present()
        self._posiziona()
        GLib.timeout_add(30, lambda: (self.rivela.set_reveal_child(True), False)[1])
        GLib.timeout_add(260, lambda: (self._posiziona(), False)[1])

    def _chiudi_presto(self):
        # piccolo ritardo: lascia aprire finestre di dialogo nostre senza chiudere tutto
        GLib.timeout_add(150, lambda: (self.destroy() if not self.is_active() and not self._dialogo else None, False)[1])

    _dialogo = False

    def _posiziona(self):
        display = Gdk.Display.get_default()
        _, px, py = display.get_default_seat().get_pointer().get_position()
        monitor = display.get_monitor_at_point(px, py)
        area = monitor.get_workarea()
        # misura il contenuto vero (durante l'animazione la finestra è ancora "chiusa")
        l = max(self.get_size()[0], self.scatola.get_preferred_width()[1])
        a = self.scatola.get_preferred_height_for_width(l)[1]
        x = min(max(px - l // 2, area.x + 10), area.x + area.width - l - 10)
        y = area.y + area.height - a - 10
        self.move(x, y)

    def intestazione(self, titolo, controllo=None):
        riga = Gtk.Box(spacing=8)
        if self.indietro:
            b = Gtk.Button.new_from_icon_name("go-previous-symbolic", Gtk.IconSize.BUTTON)
            b.set_relief(Gtk.ReliefStyle.NONE)
            b.connect("clicked", lambda *_: self.indietro())
            riga.pack_start(b, False, False, 0)
        riga.pack_start(etichetta(titolo, "titolo"), True, True, 0)
        if controllo is not None:
            riga.pack_end(controllo, False, False, 0)
        self.contenitore.pack_start(riga, False, False, 0)
        return riga

    def piede(self, testo, pagina):
        b = Gtk.Button(label=testo)
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.set_halign(Gtk.Align.START)
        b.connect("clicked", lambda *_: (avvia(["alba-impostazioni", "--pagina", pagina]), self.destroy()))
        box = Gtk.Box()
        box.get_style_context().add_class("piede")
        box.pack_start(b, False, False, 0)
        self.contenitore.pack_end(box, False, False, 0)
        self.contenitore.pack_end(Gtk.Separator(), False, False, 0)

    @staticmethod
    def elenco_scorrevole(altezza=330):
        s = Gtk.ScrolledWindow()
        s.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        s.set_propagate_natural_height(True)
        s.set_max_content_height(altezza)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        s.add(box)
        return s, box

    # ------------------------------------------------------------------ Wi-Fi
    def costruisci_wifi(self):
        self.wifi_on = Interruttore(self._wifi_radio)
        self.rotella = Gtk.Spinner()
        h = self.intestazione("Wi-Fi", self.wifi_on)
        h.pack_end(self.rotella, False, False, 0)
        self.stato = etichetta("", "piccolo")
        self.contenitore.pack_start(self.stato, False, False, 0)
        scorri, self.reti = self.elenco_scorrevole()
        self.contenitore.pack_start(scorri, True, True, 0)
        self.piede("Altre impostazioni di rete…", "wifi")
        self._carica_reti(cerca=True)

    def _wifi_radio(self, acceso):
        esegui(["nmcli", "radio", "wifi", "on" if acceso else "off"])
        GLib.timeout_add(1800, lambda: (self._carica_reti(cerca=True), False)[1])

    def _carica_reti(self, cerca=False):
        self.rotella.start()

        def leggi():
            if DEMO or not esiste("nmcli"):
                return ("enabled", "CasaMia", [("*", "CasaMia", 92, "WPA2"), ("", "Vodafone-5G", 70, "WPA2"),
                                               ("", "TIM-Fibra", 55, "WPA2"), ("", "Ospiti", 41, "")], set())
            stato = uscita(["nmcli", "radio", "wifi"])
            elenco = uscita(["nmcli", "-t", "-e", "yes", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi",
                             "list", "--rescan", "yes" if cerca else "auto"], timeout=25)
            reti = {}
            for l in elenco.splitlines():
                p = A.dividi_nmcli(l)
                if len(p) >= 4 and p[1]:
                    s = int(p[2] or 0)
                    if p[1] not in reti or s > reti[p[1]][2] or p[0] == "*":
                        reti[p[1]] = (p[0], p[1], s, p[3])
            note = {A.dividi_nmcli(l)[0] for l in uscita(["nmcli", "-t", "-f", "NAME,TYPE", "connection",
                                                         "show"]).splitlines() if "wireless" in l}
            attiva = next((r[1] for r in reti.values() if r[0] == "*"), "")
            return stato, attiva, sorted(reti.values(), key=lambda r: (r[0] != "*", -r[2])), note

        in_sottofondo(leggi, self._mostra_reti)

    def _mostra_reti(self, dati):
        self.rotella.stop()
        if not dati:
            return
        stato, attiva, reti, note = dati
        acceso = stato == "enabled"
        self.wifi_on.imposta(acceso)
        self.stato.set_text(f"Collegato a {attiva}" if attiva else ("Scegli una rete" if acceso else "Il Wi-Fi è spento"))
        for c in self.reti.get_children():
            self.reti.remove(c)
        if acceso and not reti:
            self.reti.pack_start(etichetta("Nessuna rete trovata. Sto cercando…", "piccolo"), False, False, 6)
        for uso, ssid, segnale, sic in (reti if acceso else [])[:25]:
            self.reti.pack_start(self._riga_rete(uso == "*", ssid, segnale, sic, ssid in note), False, False, 0)
        self.reti.show_all()
        self.resize(1, 1)
        GLib.idle_add(self._posiziona)

    def _riga_rete(self, attiva, ssid, segnale, sicurezza, nota):
        contenitore = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        b = Gtk.Button()
        b.get_style_context().add_class("voce")
        if attiva:
            b.get_style_context().add_class("voce-attiva")
        riga = Gtk.Box(spacing=10)
        riga.pack_start(Gtk.Image.new_from_icon_name(f"alba-wifi-{TACCHE(segnale)}-symbolic",
                                                     Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
        testi = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        nome = etichetta(ssid)
        nome.set_ellipsize(Pango.EllipsizeMode.END)
        testi.pack_start(nome, False, False, 0)
        testi.pack_start(etichetta("Collegato" if attiva else ("Protetta" if sicurezza else "Aperta"), "piccolo"), False, False, 0)
        riga.pack_start(testi, True, True, 0)
        if sicurezza:
            riga.pack_end(Gtk.Image.new_from_icon_name("changes-prevent-symbolic", Gtk.IconSize.MENU), False, False, 0)
        b.add(riga)
        contenitore.pack_start(b, False, False, 0)
        # Password direttamente nella riga (niente finestre a parte)
        rivela = Gtk.Revealer()
        box = Gtk.Box(spacing=6)
        box.set_margin_start(42)
        box.set_margin_end(6)
        box.set_margin_bottom(6)
        campo = Gtk.Entry(visibility=False, placeholder_text="Password della rete")
        campo.set_hexpand(True)
        vai = pulsante("Collega", principale=True)
        box.pack_start(campo, True, True, 0)
        box.pack_start(vai, False, False, 0)
        rivela.add(box)
        contenitore.pack_start(rivela, False, False, 0)

        def collega(password=None):
            self.rotella.start()
            self.stato.set_text(f"Mi collego a {ssid}…")

            def fai():
                if nota and not password:
                    return esegui(["nmcli", "connection", "up", "id", ssid], timeout=45)
                cmd = ["nmcli", "device", "wifi", "connect", ssid]
                if password:
                    cmd += ["password", password]
                return esegui(cmd, timeout=45)

            def fatto(r):
                if r and r[0] != 0:
                    self.stato.set_text("Password errata o rete non raggiungibile. Riprova.")
                    if sicurezza:
                        rivela.set_reveal_child(True)
                        campo.grab_focus()
                    self.rotella.stop()
                else:
                    self._carica_reti()
            in_sottofondo(fai, fatto)

        def clic(*_):
            if attiva:
                esegui(["nmcli", "connection", "down", "id", ssid])
                self._carica_reti()
            elif sicurezza and not nota:
                rivela.set_reveal_child(not rivela.get_reveal_child())
                campo.grab_focus()
            else:
                collega()
        b.connect("clicked", clic)
        b.set_tooltip_text("Scollega" if attiva else "Collega")
        vai.connect("clicked", lambda *_: collega(campo.get_text()))
        campo.connect("activate", lambda *_: collega(campo.get_text()))
        return contenitore

    # -------------------------------------------------------------- Bluetooth
    def costruisci_bluetooth(self):
        self.bt_on = Interruttore(self._bt_radio)
        self.rotella = Gtk.Spinner()
        h = self.intestazione("Bluetooth", self.bt_on)
        h.pack_end(self.rotella, False, False, 0)
        self.stato = etichetta("", "piccolo")
        self.contenitore.pack_start(self.stato, False, False, 0)
        scorri, self.dispositivi = self.elenco_scorrevole(300)
        self.contenitore.pack_start(scorri, True, True, 0)
        self.cerca = pulsante("Cerca nuovi dispositivi", self._cerca, icona="edit-find-symbolic")
        self.contenitore.pack_start(self.cerca, False, False, 0)
        self.piede("Altre impostazioni Bluetooth…", "bluetooth")
        self.trovati = []
        self._carica_bt()

    def _bt_radio(self, acceso):
        def fai():
            if acceso:
                esegui(["rfkill", "unblock", "bluetooth"])
            esegui(["bluetoothctl", "power", "on" if acceso else "off"], timeout=10)
        in_sottofondo(fai, lambda _: GLib.timeout_add(700, lambda: (self._carica_bt(), False)[1]))

    def _carica_bt(self):
        def leggi():
            if DEMO or not esiste("bluetoothctl"):
                return True, [("00", "AirPods di Ale", True, "audio-headphones"), ("01", "Xbox Controller", False, "input-gaming")]
            info = uscita(["bluetoothctl", "show"], timeout=5)
            if not info:
                return None
            elenco = []
            for l in uscita(["bluetoothctl", "devices", "Paired"], timeout=5).splitlines():
                p = l.split(" ", 2)
                if len(p) == 3 and p[0] == "Device":
                    d = uscita(["bluetoothctl", "info", p[1]], timeout=5)
                    ic = re.search(r"Icon: (\S+)", d)
                    elenco.append((p[1], p[2], "Connected: yes" in d, ic.group(1) if ic else "bluetooth"))
            return "Powered: yes" in info, elenco
        in_sottofondo(leggi, self._mostra_bt)

    def _mostra_bt(self, dati):
        self.rotella.stop()
        for c in self.dispositivi.get_children():
            self.dispositivi.remove(c)
        if dati is None:
            self.stato.set_text("Nessun adattatore Bluetooth trovato")
            self.bt_on.set_sensitive(False)
            self.cerca.set_sensitive(False)
            return
        acceso, elenco = dati
        self.bt_on.imposta(acceso)
        self.cerca.set_sensitive(acceso)
        connessi = [n for _, n, c, _ in elenco if c]
        self.stato.set_text(("Connesso a " + ", ".join(connessi)) if connessi else ("Acceso" if acceso else "Spento"))
        if acceso:
            if elenco:
                self.dispositivi.pack_start(etichetta("I MIEI DISPOSITIVI", "etichetta-sezione"), False, False, 0)
            for mac, nome, connesso, icona in elenco:
                self.dispositivi.pack_start(self._riga_bt(mac, nome, icona, "Connesso" if connesso else "Non connesso",
                                                          "disconnect" if connesso else "connect", connesso), False, False, 0)
            if self.trovati:
                self.dispositivi.pack_start(etichetta("VICINI", "etichetta-sezione"), False, False, 0)
            gia = {m for m, *_ in elenco}
            for mac, nome in self.trovati:
                if mac not in gia:
                    self.dispositivi.pack_start(self._riga_bt(mac, nome, "bluetooth", "Clicca per collegare", "pair"), False, False, 0)
        self.dispositivi.show_all()
        self.resize(1, 1)
        GLib.idle_add(self._posiziona)

    def _riga_bt(self, mac, nome, icona, sotto, azione, attivo=False):
        b = Gtk.Button()
        b.get_style_context().add_class("voce")
        if attivo:
            b.get_style_context().add_class("voce-attiva")
        riga = Gtk.Box(spacing=10)
        riga.pack_start(Gtk.Image.new_from_icon_name(icona if icona != "bluetooth" else "bluetooth-active-symbolic",
                                                     Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
        testi = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        n = etichetta(nome)
        n.set_ellipsize(Pango.EllipsizeMode.END)
        testi.pack_start(n, False, False, 0)
        testi.pack_start(etichetta(sotto, "piccolo"), False, False, 0)
        riga.pack_start(testi, True, True, 0)
        b.add(riga)

        def fai():
            if azione == "pair":
                esegui(["bluetoothctl", "--timeout", "25", "pair", mac], timeout=30)
                esegui(["bluetoothctl", "trust", mac], timeout=8)
                return esegui(["bluetoothctl", "--timeout", "15", "connect", mac], timeout=20)
            return esegui(["bluetoothctl", "--timeout", "15", azione, mac], timeout=20)

        def clic(*_):
            self.rotella.start()
            self.stato.set_text(("Mi collego a " if azione != "disconnect" else "Scollego ") + nome + "…")
            in_sottofondo(fai, lambda r: (self.stato.set_text("Non riuscito: avvicina il dispositivo e mettilo in modalità di associazione")
                                          if r and r[0] != 0 else None, self._carica_bt()))
        b.connect("clicked", clic)
        return b

    def _cerca(self):
        self.rotella.start()
        self.stato.set_text("Cerco dispositivi vicini… metti il tuo in modalità di associazione")
        self.cerca.set_sensitive(False)

        def fai():
            esegui(["bluetoothctl", "--timeout", "12", "scan", "on"], timeout=16)
            trovati = []
            for l in uscita(["bluetoothctl", "devices"], timeout=5).splitlines():
                p = l.split(" ", 2)
                if len(p) == 3 and p[0] == "Device" and not re.fullmatch(r"([0-9A-F]{2}-){5}[0-9A-F]{2}", p[2]):
                    trovati.append((p[1], p[2]))
            return trovati

        def fatto(t):
            self.trovati = t or []
            self.cerca.set_sensitive(True)
            self._carica_bt()
        in_sottofondo(fai, fatto)

    # ------------------------------------------------------ Impostazioni rapide
    def costruisci_controlli(self):
        self.pila = Gtk.Stack()
        self.pila.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.pila.set_transition_duration(180)
        self.pila.set_vhomogeneous(False)
        self.pila.set_interpolate_size(True)
        self.scatola.pack_start(self.pila, True, True, 0)
        principale = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.pila.add_named(principale, "principale")
        self.sottopagine = {}

        griglia = Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True)
        self.tessere = {}
        voci = [("wifi", "Wi-Fi", "alba-wifi-4-symbolic", True),
                ("bluetooth", "Bluetooth", "alba-bluetooth-symbolic", True),
                ("risparmio", "Risparmio", "alba-batteria-50-symbolic", False),
                ("dnd", "Non disturbare", "alba-campanella-spenta-symbolic", False),
                ("aereo", "Modalità aereo", "airplane-mode-symbolic", False),
                ("scuro", "Tema scuro", "weather-clear-night-symbolic", False)]
        for i, (chiave, nome, icona, freccia) in enumerate(voci):
            griglia.attach(self._tessera(chiave, nome, icona, freccia), i % 3, i // 3, 1, 1)
        principale.pack_start(griglia, False, False, 0)

        self.cursori = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        principale.pack_start(self.cursori, False, False, 0)
        self.riga_luce = self._riga_cursore("display-brightness-symbolic", self._luce, None)
        self.riga_volume = self._riga_cursore("alba-volume-3-symbolic", self._volume, lambda: self._apri("audio"),
                                              clic_icona=self._muto)
        self.cursori.pack_start(self.riga_luce[0], False, False, 0)
        self.cursori.pack_start(self.riga_volume[0], False, False, 0)

        basso = Gtk.Box(spacing=10)
        basso.get_style_context().add_class("barra-basso")
        self.icona_batteria = Gtk.Image.new_from_icon_name("battery-full-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
        self.testo_batteria = etichetta("", "piccolo")
        basso.pack_start(self.icona_batteria, False, False, 0)
        basso.pack_start(self.testo_batteria, True, True, 0)
        ingranaggio = Gtk.Button.new_from_icon_name("emblem-system-symbolic", Gtk.IconSize.BUTTON)
        ingranaggio.set_relief(Gtk.ReliefStyle.NONE)
        ingranaggio.set_tooltip_text("Tutte le impostazioni")
        ingranaggio.connect("clicked", lambda *_: (avvia(["alba-impostazioni"]), self.destroy()))
        basso.pack_end(ingranaggio, False, False, 0)
        principale.pack_start(basso, False, False, 0)
        self._muto_agg = False
        self._carica_controlli()
        GLib.timeout_add_seconds(3, lambda: (self._carica_controlli() if self.pila.get_visible_child_name() == "principale" else None, True)[1])

    def _tessera(self, chiave, nome, icona, freccia):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        unito = Gtk.Box()
        unito.get_style_context().add_class("linked")
        b = Gtk.ToggleButton()
        b.set_image(Gtk.Image.new_from_icon_name(icona, Gtk.IconSize.LARGE_TOOLBAR))
        b.get_style_context().add_class("tessera-rapida")
        b.set_hexpand(True)
        b.connect("toggled", lambda w, k=chiave: None if self._muto_agg else self._cambia(k, w.get_active()))
        unito.pack_start(b, True, True, 0)
        if freccia:
            f = Gtk.Button.new_from_icon_name("go-next-symbolic", Gtk.IconSize.MENU)
            f.get_style_context().add_class("tessera-rapida")
            f.get_style_context().add_class("freccia")
            f.connect("clicked", lambda *_, k=chiave: self._apri(k))
            unito.pack_start(f, False, False, 0)
        box.pack_start(unito, False, False, 0)
        n = etichetta(nome, "nome-tessera", xalign=0.5)
        sotto = etichetta("", "sotto-tessera", xalign=0.5)
        sotto.set_ellipsize(Pango.EllipsizeMode.END)
        sotto.set_max_width_chars(12)
        box.pack_start(n, False, False, 0)
        box.pack_start(sotto, False, False, 0)
        self.tessere[chiave] = (b, sotto)
        return box

    def _riga_cursore(self, icona, azione, freccia, clic_icona=None):
        riga = Gtk.Box(spacing=8)
        riga.get_style_context().add_class("cursore-rapido")
        img = Gtk.Image.new_from_icon_name(icona, Gtk.IconSize.LARGE_TOOLBAR)
        if clic_icona:
            b = Gtk.Button()
            b.set_relief(Gtk.ReliefStyle.NONE)
            b.add(img)
            b.connect("clicked", lambda *_: clic_icona())
            riga.pack_start(b, False, False, 0)
        else:
            img.set_margin_start(8)
            img.set_margin_end(8)
            riga.pack_start(img, False, False, 0)
        cur = A.Cursore(azione, 0, 100)
        cur.set_size_request(220, -1)
        riga.pack_start(cur, True, True, 0)
        if freccia:
            f = Gtk.Button.new_from_icon_name("go-next-symbolic", Gtk.IconSize.MENU)
            f.set_relief(Gtk.ReliefStyle.NONE)
            f.set_tooltip_text("Scegli casse o cuffie")
            f.connect("clicked", lambda *_: freccia())
            riga.pack_start(f, False, False, 0)
        return riga, cur, img

    def _carica_controlli(self):
        def leggi():
            st = {}
            if DEMO:
                return dict(wifi=(True, "CasaMia"), bluetooth=(True, "AirPods"), risparmio=False, dnd=False,
                            aereo=False, scuro=True, luce=70, volume=45, muto=False,
                            batteria=(76, "Discharging", "3 h 40 min"))
            if esiste("nmcli"):
                on = uscita(["nmcli", "radio", "wifi"]) == "enabled"
                rete = ""
                for l in uscita(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"]).splitlines():
                    p = A.dividi_nmcli(l)
                    if len(p) >= 2 and "wireless" in p[1]:
                        rete = p[0]
                st["wifi"] = (on, rete if on else "Spento")
            if esiste("bluetoothctl"):
                info = uscita(["bluetoothctl", "show"], timeout=4)
                if info:
                    on = "Powered: yes" in info
                    nomi = [l.split(" ", 2)[2] for l in uscita(["bluetoothctl", "devices", "Connected"], timeout=4).splitlines()
                            if l.count(" ") >= 2]
                    st["bluetooth"] = (on, ", ".join(nomi) if nomi else ("Acceso" if on else "Spento"))
            if esiste("powerprofilesctl"):
                st["risparmio"] = uscita(["powerprofilesctl", "get"]) == "power-saver"
            st["dnd"] = A.xfconf_leggi("xfce4-notifyd", "/do-not-disturb") == "true"
            rf = uscita(["rfkill", "list"])
            st["aereo"] = bool(rf) and "Soft blocked: no" not in rf
            st["scuro"] = A.leggi_file(os.path.join(A.CONF, "tema"), "scuro") != "chiaro"
            b = uscita(["brightnessctl", "-m", "-c", "backlight"]) if esiste("brightnessctl") else ""
            try:
                st["luce"] = int(b.split(",")[3].rstrip("%"))
            except (IndexError, ValueError):
                st["luce"] = None
            v = re.search(r"(\d+)%", uscita(["pactl", "get-sink-volume", "@DEFAULT_SINK@"])) if esiste("pactl") else None
            st["volume"] = int(v.group(1)) if v else None
            st["muto"] = "yes" in uscita(["pactl", "get-sink-mute", "@DEFAULT_SINK@"]) if esiste("pactl") else False
            d = A.dati_batteria()
            st["batteria"] = (d["livello"], d["stato"], d["tempo"]) if d else None
            return st
        in_sottofondo(leggi, self._mostra_controlli)

    def _mostra_controlli(self, st):
        if not st:
            return
        self._muto_agg = True
        for chiave, (b, sotto) in self.tessere.items():
            valore = st.get(chiave)
            if valore is None:
                b.set_sensitive(False)
                sotto.set_text("Non disponibile")
                continue
            attivo, testo = valore if isinstance(valore, tuple) else (valore, "Attivo" if valore else "")
            b.set_active(bool(attivo))
            sotto.set_text(testo or "")
        self._muto_agg = False
        riga, cur, _ = self.riga_luce
        riga.set_visible(st.get("luce") is not None)
        if st.get("luce") is not None:
            cur.imposta(st["luce"])
        riga, cur, img = self.riga_volume
        if st.get("volume") is not None:
            cur.imposta(st["volume"])
            v = st["volume"]
            img.set_from_icon_name(icona_volume(v, st.get("muto")), Gtk.IconSize.LARGE_TOOLBAR)
        bat = st.get("batteria")
        if bat:
            livello, stato, tempo = bat
            self.icona_batteria.set_from_icon_name(icona_batteria(livello, stato), Gtk.IconSize.LARGE_TOOLBAR)
            extra = " · in carica" if stato == "Charging" else (f" · {tempo}" if tempo else "")
            self.testo_batteria.set_text(f"{livello}%{extra}")
        else:
            self.icona_batteria.set_from_icon_name("ac-adapter-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
            self.testo_batteria.set_text("Collegato alla corrente")

    def _cambia(self, chiave, attivo):
        if chiave == "wifi":
            esegui(["nmcli", "radio", "wifi", "on" if attivo else "off"])
        elif chiave == "bluetooth":
            if attivo:
                esegui(["rfkill", "unblock", "bluetooth"])
            in_sottofondo(lambda: esegui(["bluetoothctl", "power", "on" if attivo else "off"], timeout=8))
        elif chiave == "risparmio":
            esegui(["powerprofilesctl", "set", "power-saver" if attivo else "balanced"])
        elif chiave == "dnd":
            A.xfconf_scrivi("xfce4-notifyd", "/do-not-disturb", "bool", attivo)
        elif chiave == "aereo":
            esegui(["rfkill", "block" if attivo else "unblock", "all"])
        elif chiave == "scuro":
            in_sottofondo(lambda: esegui(["/usr/bin/alba-tema", "scuro" if attivo else "chiaro"]))
        GLib.timeout_add(900, lambda: (self._carica_controlli(), False)[1])

    def _luce(self, v):
        esegui(["brightnessctl", "-q", "-c", "backlight", "set", f"{max(v, 3)}%"])

    def _volume(self, v):
        esegui(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "0"])
        esegui(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{v}%"])
        esegui(["canberra-gtk-play", "-i", "audio-volume-change"])
        self._aggiorna_stato()

    def _muto(self):
        esegui(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "toggle"])
        self._aggiorna_stato()

    def _aggiorna_stato(self):
        if hasattr(self, "tessere"):
            self._carica_controlli()
        elif hasattr(self, "volume_solo"):
            self._leggi_volume()

    def _apri(self, pagina):
        if pagina not in self.sottopagine:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            self.sottopagine[pagina] = box
            self.pila.add_named(box, pagina)
            self.contenitore = box
            self.indietro = self._torna
            {"wifi": self.costruisci_wifi, "bluetooth": self.costruisci_bluetooth, "audio": self.costruisci_audio}[pagina]()
            self.contenitore = self.scatola
            box.show_all()
        self.pila.set_visible_child_name(pagina)
        GLib.idle_add(self._posiziona)

    def _torna(self):
        self.pila.set_visible_child_name("principale")
        self._carica_controlli()
        self.resize(1, 1)
        GLib.timeout_add(200, lambda: (self._posiziona(), False)[1])

    def costruisci_audio(self):
        self.intestazione("Audio")
        if not self.indietro:   # aperto dall'icona del volume: tutto qui, senza sottomenu
            riga, cur, img = self._riga_cursore("alba-volume-3-symbolic", self._volume, None, clic_icona=self._muto)
            self.volume_solo = (cur, img)
            self.contenitore.pack_start(riga, False, False, 0)
            self._leggi_volume()
        self.contenitore.pack_start(etichetta("RIPRODUCI DA", "etichetta-sezione"), False, False, 0)
        uscite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.contenitore.pack_start(uscite, False, False, 0)
        self.contenitore.pack_start(etichetta("MICROFONO", "etichetta-sezione"), False, False, 0)
        ingressi = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.contenitore.pack_start(ingressi, False, False, 0)
        self.piede("Altre impostazioni audio…", "suono")

        def riempi():
            for box, tipo, comando, predefinito in ((uscite, "sinks", "set-default-sink", "get-default-sink"),
                                                    (ingressi, "sources", "set-default-source", "get-default-source")):
                for c in box.get_children():
                    box.remove(c)
                attuale = uscita(["pactl", predefinito])
                elenco = A.PaginaSuono._dispositivi(tipo) if not DEMO else (
                    [("a", "Altoparlanti"), ("b", "Cuffie AirPods")] if tipo == "sinks" else [("c", "Microfono interno")])
                for nome, descr in elenco:
                    b = Gtk.Button()
                    b.get_style_context().add_class("voce")
                    if nome == attuale or (DEMO and nome in ("a", "c")):
                        b.get_style_context().add_class("voce-attiva")
                    r = Gtk.Box(spacing=10)
                    icona = "audio-headphones-symbolic" if re.search(r"cuffi|head|airpod|bluez", descr + nome, re.I) else (
                        "audio-input-microphone-symbolic" if tipo == "sources" else "audio-speakers-symbolic")
                    r.pack_start(Gtk.Image.new_from_icon_name(icona, Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
                    t = etichetta(descr)
                    t.set_ellipsize(Pango.EllipsizeMode.END)
                    r.pack_start(t, True, True, 0)
                    b.add(r)
                    b.connect("clicked", lambda *_, n=nome, c=comando: (esegui(["pactl", c, n]), riempi()))
                    box.pack_start(b, False, False, 0)
                box.show_all()
        riempi()

    def _leggi_volume(self):
        def leggi():
            if DEMO:
                return 45, False
            v = re.search(r"(\d+)%", uscita(["pactl", "get-sink-volume", "@DEFAULT_SINK@"])) if esiste("pactl") else None
            return (int(v.group(1)) if v else None), "yes" in uscita(["pactl", "get-sink-mute", "@DEFAULT_SINK@"])

        def mostra(r):
            v, muto = r or (None, False)
            cur, img = self.volume_solo
            if v is None:
                cur.set_sensitive(False)
                return
            cur.imposta(v)
            img.set_from_icon_name(icona_volume(v, muto), Gtk.IconSize.LARGE_TOOLBAR)
        in_sottofondo(leggi, mostra)

    # --------------------------------------------------------------- Batteria
    MODI = [("power-saver", "Risparmio", "power-profile-power-saver-symbolic"),
            ("balanced", "Bilanciata", "power-profile-balanced-symbolic"),
            ("performance", "Prestazioni", "power-profile-performance-symbolic")]

    def costruisci_batteria(self):
        alto = Gtk.Box(spacing=14)
        self.bat_icona = Gtk.Image.new_from_icon_name("alba-batteria-100-symbolic", Gtk.IconSize.DIALOG)
        self.bat_icona.set_pixel_size(52)
        alto.pack_start(self.bat_icona, False, False, 0)
        testi = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        testi.set_valign(Gtk.Align.CENTER)
        self.bat_percento = etichetta("", "batteria-grande")
        self.bat_stato = etichetta("", "piccolo")
        testi.pack_start(self.bat_percento, False, False, 0)
        testi.pack_start(self.bat_stato, False, False, 0)
        alto.pack_start(testi, True, True, 0)
        self.contenitore.pack_start(alto, False, False, 0)

        self.contenitore.pack_start(etichetta("MODALITÀ DI ALIMENTAZIONE", "etichetta-sezione"), False, False, 4)
        modi = Gtk.Box(spacing=8, homogeneous=True)
        self.bottoni_modo = {}
        for chiave, nome, icona in self.MODI:
            b = Gtk.ToggleButton()
            b.get_style_context().add_class("modo-energia")
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            box.pack_start(Gtk.Image.new_from_icon_name(icona, Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
            box.pack_start(etichetta(nome, "nome-tessera", xalign=0.5), False, False, 0)
            b.add(box)
            b.connect("toggled", lambda w, k=chiave: self._scegli_modo(k, w))
            modi.pack_start(b, True, True, 0)
            self.bottoni_modo[chiave] = b
        self.contenitore.pack_start(modi, False, False, 0)
        self.nota_modo = etichetta("", "piccolo", wrap=True)
        self.contenitore.pack_start(self.nota_modo, False, False, 0)

        self.riga_luce = self._riga_cursore("display-brightness-symbolic", self._luce, None)
        self.riga_luce[0].set_no_show_all(True)
        self.contenitore.pack_start(self.riga_luce[0], False, False, 4)
        self.piede("Impostazioni batteria e consumi…", "batteria")
        self._muto_agg = False
        self._carica_batteria()
        GLib.timeout_add_seconds(10, lambda: (self._carica_batteria(), True)[1])

    def _carica_batteria(self):
        def leggi():
            st = {"batteria": A.dati_batteria()}
            if DEMO:
                st.update(modo="balanced", modi=["power-saver", "balanced", "performance"], luce=70)
                return st
            st["modo"] = uscita(["powerprofilesctl", "get"]) if esiste("powerprofilesctl") else ""
            elenco = uscita(["powerprofilesctl", "list"]) if esiste("powerprofilesctl") else ""
            st["modi"] = [k for k, *_ in self.MODI if re.search(rf"^\s*\*?\s*{k}:", elenco, re.M)]
            b = uscita(["brightnessctl", "-m", "-c", "backlight"]) if esiste("brightnessctl") else ""
            try:
                st["luce"] = int(b.split(",")[3].rstrip("%"))
            except (IndexError, ValueError):
                st["luce"] = None
            return st
        in_sottofondo(leggi, self._mostra_batteria)

    def _mostra_batteria(self, st):
        if not st:
            return
        d = st.get("batteria")
        if d:
            self.bat_icona.set_from_icon_name(icona_batteria(d["livello"], d["stato"]), Gtk.IconSize.DIALOG)
            self.bat_percento.set_text(f"{d['livello']}%")
            if d["stato"] == "Charging":
                testo = "In carica" + (f" · {d['tempo']}" if d.get("tempo") else "")
            elif d["stato"] in ("Full", "Not charging"):
                testo = "Carica completa, collegato alla corrente"
            else:
                testo = d.get("tempo") or "In uso a batteria"
            self.bat_stato.set_text(testo)
        else:
            self.bat_icona.set_from_icon_name("ac-adapter-symbolic", Gtk.IconSize.DIALOG)
            self.bat_percento.set_text("Alimentazione")
            self.bat_stato.set_text("Collegato alla corrente")
        self._muto_agg = True
        for chiave, b in self.bottoni_modo.items():
            b.set_sensitive(chiave in st.get("modi", []))
            b.set_active(chiave == st.get("modo"))
        self._muto_agg = False
        if not st.get("modi"):
            self.nota_modo.set_text("Le modalità non sono disponibili su questo computer.")
            self.nota_modo.show()
        else:
            self.nota_modo.set_text({"power-saver": "La batteria dura di più: schermo e processore consumano meno.",
                                     "balanced": "Il giusto equilibrio fra durata e velocità.",
                                     "performance": "Massima velocità per giochi e montaggio video. Consuma di più."
                                     }.get(st.get("modo"), ""))
        riga, cur, _ = self.riga_luce
        if st.get("luce") is not None:
            riga.set_no_show_all(False)
            riga.show_all()
            cur.imposta(st["luce"])
        self.resize(1, 1)
        GLib.idle_add(self._posiziona)

    def _scegli_modo(self, chiave, bottone):
        if self._muto_agg:
            return
        if not bottone.get_active():   # non si può "spegnere" la modalità scelta
            self._muto_agg = True
            bottone.set_active(True)
            self._muto_agg = False
            return
        esegui(["powerprofilesctl", "set", chiave])
        self._carica_batteria()

    # --------------------------------------------------------------- Notifiche
    def costruisci_notifiche(self):
        alto = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.ora = etichetta("", "ora-grande")
        self.data = etichetta("", "piccolo")
        alto.pack_start(self.ora, False, False, 0)
        alto.pack_start(self.data, False, False, 0)
        self.scatola.pack_start(alto, False, False, 0)
        self._tic()
        GLib.timeout_add_seconds(1, self._tic)
        cal = Gtk.Calendar()
        cal.set_display_options(Gtk.CalendarDisplayOptions.SHOW_HEADING | Gtk.CalendarDisplayOptions.SHOW_DAY_NAMES)
        self.scatola.pack_start(cal, False, False, 0)
        self.scatola.pack_start(Gtk.Separator(), False, False, 4)
        self.dnd = Interruttore(lambda v: A.xfconf_scrivi("xfce4-notifyd", "/do-not-disturb", "bool", v))
        self.dnd.imposta(A.xfconf_leggi("xfce4-notifyd", "/do-not-disturb") == "true")
        riga = Gtk.Box(spacing=8)
        riga.pack_start(etichetta("Notifiche", "titolo"), True, True, 0)
        cancella = Gtk.Button(label="Cancella tutto")
        cancella.set_relief(Gtk.ReliefStyle.NONE)
        cancella.connect("clicked", lambda *_: (cancella_notifiche(), self._mostra_notifiche()))
        riga.pack_end(cancella, False, False, 0)
        self.scatola.pack_start(riga, False, False, 0)
        scorri, self.notifiche = self.elenco_scorrevole(260)
        self.scatola.pack_start(scorri, True, True, 0)
        dnd = Gtk.Box(spacing=8)
        dnd.pack_start(Gtk.Image.new_from_icon_name("notifications-disabled-symbolic", Gtk.IconSize.MENU), False, False, 0)
        dnd.pack_start(etichetta("Non disturbare"), True, True, 0)
        dnd.pack_end(self.dnd, False, False, 0)
        self.scatola.pack_end(dnd, False, False, 0)
        self.scatola.pack_end(Gtk.Separator(), False, False, 0)
        self._mostra_notifiche()

    def _tic(self):
        if not self.get_window() and self.ora.get_text():
            return False
        self.ora.set_text(time.strftime("%H:%M"))
        self.data.set_text(time.strftime("%A %d %B").capitalize())
        return True

    def _mostra_notifiche(self):
        for c in self.notifiche.get_children():
            self.notifiche.remove(c)
        elenco = leggi_notifiche()
        if not elenco:
            self.notifiche.pack_start(etichetta("Nessuna notifica", "piccolo", xalign=0.5), False, False, 18)
        gruppi = {}
        for n in elenco:
            gruppi.setdefault(n["app"], []).append(n)
        for app, voci in list(gruppi.items())[:12]:
            self.notifiche.pack_start(etichetta(app.upper(), "etichetta-sezione"), False, False, 0)
            for n in voci[:4]:
                box = Gtk.Box(spacing=10)
                box.get_style_context().add_class("notifica")
                box.pack_start(Gtk.Image.new_from_icon_name(n["icona"] or "dialog-information-symbolic",
                                                            Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
                testi = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                t = etichetta(n["titolo"], "riga-titolo", wrap=True)
                testi.pack_start(t, False, False, 0)
                if n["testo"]:
                    corpo = etichetta(re.sub(r"<[^>]+>", "", n["testo"])[:220], "piccolo", wrap=True)
                    corpo.set_max_width_chars(38)
                    testi.pack_start(corpo, False, False, 0)
                box.pack_start(testi, True, True, 0)
                box.pack_end(etichetta(n["quando"], "piccolo"), False, False, 0)
                self.notifiche.pack_start(box, False, False, 2)
        self.notifiche.show_all()
        self.resize(1, 1)
        GLib.idle_add(self._posiziona)


def icona_volume(v, muto=False):
    if muto:
        return "alba-volume-muto-symbolic"
    return f"alba-volume-{0 if v == 0 else 1 if v < 34 else 2 if v < 67 else 3}-symbolic"


def icona_batteria(livello, stato):
    carica = "-carica" if stato in ("Charging", "Full") else ""
    return f"alba-batteria-{min(100, int(round(livello / 10.0)) * 10)}{carica}-symbolic"


# ---------------------------------------------------------------------------
# Registro delle notifiche di xfce4-notifyd (vecchio formato e SQLite)
# ---------------------------------------------------------------------------
CARTELLA_LOG = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "xfce4", "notifyd")


def _quando(ts):
    try:
        t = float(ts)
        if t > 1e12:
            t /= 1e6
    except (TypeError, ValueError):
        try:
            t = time.mktime(time.strptime(str(ts)[:19], "%Y-%m-%dT%H:%M:%S"))
        except ValueError:
            return ""
    oggi = time.strftime("%Y%m%d")
    return time.strftime("%H:%M" if time.strftime("%Y%m%d", time.localtime(t)) == oggi else "%d/%m", time.localtime(t))


def leggi_notifiche():
    if DEMO:
        return [{"app": "Alba", "titolo": "Alba è stata aggiornata", "testo": "Il nuovo aspetto è pronto.",
                 "icona": "alba-logo", "quando": "18:42"},
                {"app": "Steam", "titolo": "Download completato", "testo": "BeamNG.drive è pronto per giocare.",
                 "icona": "steam", "quando": "18:30"},
                {"app": "Firefox", "titolo": "Download completato", "testo": "documento.pdf", "icona": "firefox-esr",
                 "quando": "17:05"}]
    risultato = []
    for db in glob.glob(os.path.join(CARTELLA_LOG, "*.sqlite")) + glob.glob(os.path.join(CARTELLA_LOG, "*.db")):
        try:
            con = sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=1)
            for (tabella,) in con.execute("SELECT name FROM sqlite_master WHERE type='table'"):
                colonne = [c[1] for c in con.execute(f"PRAGMA table_info('{tabella}')")]
                if "summary" not in colonne:
                    continue
                scegli = lambda *nomi: next((n for n in nomi if n in colonne), "NULL")
                q = (f"SELECT {scegli('app_name', 'app_id')}, summary, {scegli('body')}, {scegli('app_icon', 'icon_id', 'icon')}, "
                     f"{scegli('timestamp', 'time')} FROM '{tabella}' ORDER BY {scegli('timestamp', 'time', 'rowid')} DESC LIMIT 60")
                for app, titolo, testo, icona, ts in con.execute(q):
                    risultato.append({"app": app or "Sistema", "titolo": titolo or "", "testo": testo or "",
                                      "icona": icona if icona and "/" not in str(icona) else None, "quando": _quando(ts)})
            con.close()
        except sqlite3.Error:
            continue
    vecchio = os.path.join(CARTELLA_LOG, "log")
    if not risultato and os.path.exists(vecchio):
        cp = configparser.RawConfigParser(strict=False, interpolation=None)
        try:
            cp.read(vecchio, encoding="utf-8")
            for sez in reversed(cp.sections()[-60:]):
                v = cp[sez]
                risultato.append({"app": v.get("app_name", "Sistema"), "titolo": v.get("summary", ""),
                                  "testo": v.get("body", ""), "icona": v.get("app_icon") if "/" not in v.get("app_icon", "/") else None,
                                  "quando": _quando(sez)})
        except configparser.Error:
            pass
    return risultato


def cancella_notifiche():
    for db in glob.glob(os.path.join(CARTELLA_LOG, "*.sqlite")) + glob.glob(os.path.join(CARTELLA_LOG, "*.db")):
        try:
            con = sqlite3.connect(db, timeout=2)
            for (tabella,) in con.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall():
                if "summary" in [c[1] for c in con.execute(f"PRAGMA table_info('{tabella}')")]:
                    con.execute(f"DELETE FROM '{tabella}'")
            con.commit()
            con.close()
        except sqlite3.Error:
            pass
    vecchio = os.path.join(CARTELLA_LOG, "log")
    if os.path.exists(vecchio):
        open(vecchio, "w").close()


if __name__ == "__main__":
    modo = sys.argv[1] if len(sys.argv) > 1 else "controlli"
    # Ogni icona apre il SUO menu (Wi-Fi -> reti, batteria -> batteria...);
    # le impostazioni rapide con tutto insieme restano su Super+A.
    if modo not in ("wifi", "bluetooth", "audio", "batteria", "controlli", "notifiche"):
        print(__doc__)
        sys.exit(1)
    # Un solo menu alla volta: un secondo clic sulla stessa icona lo chiude,
    # un clic su un'altra icona apre subito l'altro menu.
    blocco = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "alba-rapido.pid")
    try:
        parti = open(blocco).read().split()
        vecchio, vecchio_modo = int(parti[0]), (parti[1] if len(parti) > 1 else "")
        if b"alba-rapido" in open(f"/proc/{vecchio}/cmdline", "rb").read():
            os.kill(vecchio, 15)
            os.remove(blocco)
            if vecchio_modo == modo:
                sys.exit(0)
    except (OSError, ValueError, IndexError):
        pass
    open(blocco, "w").write(f"{os.getpid()} {modo}")
    try:
        finestra = Rapido(modo)
        finestra.connect("destroy", Gtk.main_quit)
        Gtk.main()
    finally:
        try:
            os.remove(blocco)
        except OSError:
            pass
