#!/usr/bin/python3
"""Alba Linux - passaggio morbido dalla schermata di accesso al desktop.
Copre lo schermo con lo stesso sfondo della schermata di accesso mentre il
desktop si prepara, poi svanisce dolcemente mostrando il desktop pronto
(niente pezzi che compaiono uno alla volta)."""
import subprocess
import time

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk  # noqa: E402

SFONDO = "/usr/share/backgrounds/alba/accesso.png"
MASSIMO = 6.0      # secondi al massimo, poi svanisce comunque
inizio = time.monotonic()

schermo = Gdk.Screen.get_default()
finestra = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
finestra.set_decorated(False)
finestra.set_skip_taskbar_hint(True)
finestra.set_skip_pager_hint(True)
finestra.set_keep_above(True)
finestra.set_accept_focus(False)
finestra.set_type_hint(Gdk.WindowTypeHint.SPLASHSCREEN)
L, A = schermo.get_width(), schermo.get_height()
finestra.move(0, 0)
finestra.set_default_size(L, A)
visuale = schermo.get_rgba_visual()
if visuale:
    finestra.set_visual(visuale)
try:
    originale = GdkPixbuf.Pixbuf.new_from_file(SFONDO)
    s = max(L / originale.get_width(), A / originale.get_height())
    immagine = originale.scale_simple(int(originale.get_width() * s) + 1, int(originale.get_height() * s) + 1,
                                      GdkPixbuf.InterpType.BILINEAR)
except GLib.Error:
    immagine = None
stato = {"alfa": 1.0}


def disegna(w, cr):
    cr.set_operator(1)  # SOURCE: la trasparenza della finestra è quella che disegniamo
    if immagine:
        Gdk.cairo_set_source_pixbuf(cr, immagine, (L - immagine.get_width()) / 2, (A - immagine.get_height()) / 2)
        cr.paint_with_alpha(stato["alfa"])
        cr.set_operator(2)  # OVER
        cr.set_source_rgba(0.02, 0.03, 0.08, 0.30 * stato["alfa"])
        cr.paint()
    else:
        cr.set_source_rgba(0.04, 0.06, 0.16, stato["alfa"])
        cr.paint()
    return True


area = Gtk.DrawingArea()
area.connect("draw", disegna)
finestra.add(area)
finestra.show_all()


def pronto():
    """Il desktop è pronto quando barra e sfondo sono partiti."""
    for p in ("xfce4-panel", "xfdesktop"):
        if subprocess.run(["pgrep", "-x", p], capture_output=True).returncode != 0:
            return False
    return True


def svanisci():
    if not schermo.is_composited():
        Gtk.main_quit()   # senza effetti grafici: sparisce e basta
        return False
    t0 = time.monotonic()

    def tic():
        t = min(1.0, (time.monotonic() - t0) / 0.5)
        stato["alfa"] = (1 - t) ** 2
        area.queue_draw()
        if t >= 1.0:
            Gtk.main_quit()
            return False
        return True
    GLib.timeout_add(16, tic)
    return False


def attendi():
    trascorso = time.monotonic() - inizio
    if (pronto() and trascorso > 1.2) or trascorso > MASSIMO:
        GLib.timeout_add(500, svanisci)   # un attimo per far disegnare barra e icone
        return False
    return True


GLib.timeout_add(150, attendi)
Gtk.main()
