    # ------------------------------------------------------------ generale
    def _disegna_sfondo(self, w, cr):
        L, A = w.get_allocated_width(), w.get_allocated_height()
        if self.sfondo:
            s = max(L / self.sfondo.get_width(), A / self.sfondo.get_height())
            if not hasattr(self, "_scalato") or self._scalato.get_width() < L:
                self._scalato = self.sfondo.scale_simple(int(self.sfondo.get_width() * s) + 1,
                                                         int(self.sfondo.get_height() * s) + 1,
                                                         GdkPixbuf.InterpType.BILINEAR)
            Gdk.cairo_set_source_pixbuf(cr, self._scalato, (L - self._scalato.get_width()) / 2,
                                        (A - self._scalato.get_height()) / 2)
            cr.paint()
        cr.set_source_rgba(1.0, 0.973, 0.949, 0.45)
        cr.paint()

    def mostra(self, i):
        self.indice = max(0, min(i, len(self.PAGINE) - 1))
        p = self.PAGINE[self.indice]
        self.pila.set_visible_child_name(p)
        titolo, spiega = self.TITOLI[p]
        self.passo.set_text(f"Passo {self.indice + 1} di {len(self.PAGINE) - 1}" if p != "fine" else "Quasi fatto")
        self.titolo_lato.set_text(titolo)
        self.spiega_lato.set_text(spiega)
        for j, d in enumerate(self.puntini.get_children()):
            (d.get_style_context().add_class if j == self.indice else d.get_style_context().remove_class)("attivo")
        self.indietro.set_visible(0 < self.indice < len(self.PAGINE) - 1)
        self.avanti.set_visible(p != "fine")
        self.avanti.set_label("Fine" if p == "aspetto" else ("Salta" if p == "rete" and not self.connesso else "Avanti"))
        self.errore.set_text("")
        if p == "account":
            GLib.idle_add(self.nome.grab_focus)
        if p == "rete":
            self.cerca_reti()
        if p == "fine":
            self.applica()

    def vai(self, verso):
        if verso > 0:
            errore = self.controlla(self.PAGINE[self.indice])
            if errore:
                self.errore.set_text(errore)
                return
        self.mostra(self.indice + verso)

    def controlla(self, p):
        if p == "account":
            nome, utente = self.nome.get_text().strip(), self.utente.get_text().strip()
            if not nome:
                return "Scrivi il tuo nome."
            if not re.fullmatch(r"[a-z][a-z0-9_-]{0,30}", utente):
                return "Il nome utente può avere solo lettere minuscole e numeri."
            if len(self.password.get_text()) < 4:
                return "Scegli una password di almeno 4 caratteri."
            if self.password.get_text() != self.conferma.get_text():
                return "Le due password non sono uguali."
        return None

