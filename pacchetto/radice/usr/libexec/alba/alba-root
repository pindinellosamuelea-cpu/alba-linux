#!/bin/bash
# Alba Linux - piccole operazioni da amministratore richieste dall'app
# Impostazioni (tramite pkexec, che chiede la password).
# Accetta solo i comandi elencati qui sotto, con argomenti controllati.
set -u
[ "$(id -u)" -eq 0 ] || { echo "Servono i permessi di amministratore" >&2; exit 1; }
export DEBIAN_FRONTEND=noninteractive
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

ARG="${2:-}"
case "${1:-}" in
  aggiorna-lista)
    apt-get update -q
    ;;
  aggiorna-prepara)
    # scarica ora, installa al riavvio (prima dell'accesso)
    /usr/libexec/alba/alba-aggiornamento prepara
    esito=$?
    /usr/libexec/alba/alba-driver-auto --aggiornamento >/dev/null 2>&1
    exit $esito
    ;;
  aggiorna-annulla)
    /usr/libexec/alba/alba-aggiornamento annulla
    ;;
  aggiorna-installa)
    apt-get update -q || true
    apt-get -y -q -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
      --with-new-pkgs upgrade
    esito=$?
    command -v flatpak >/dev/null && flatpak update -y --noninteractive --system >/dev/null 2>&1
    # Driver grafico migliore per questo computer (se serve)
    /usr/libexec/alba/alba-driver-auto --aggiornamento >/dev/null 2>&1
    /usr/libexec/alba/alba-extra >/dev/null 2>&1
    exit $esito
    ;;
  firewall)
    case "$ARG" in
      on)  ufw --force enable ;;
      off) ufw disable ;;
      *) exit 2 ;;
    esac
    ;;
  ntp)
    case "$ARG" in
      on)  timedatectl set-ntp true ;;
      off) timedatectl set-ntp false ;;
      *) exit 2 ;;
    esac
    ;;
  fuso)
    timedatectl list-timezones | grep -qxF -- "$ARG" || exit 2
    timedatectl set-timezone "$ARG"
    ;;
  imposta-ora)
    [[ "$ARG" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}$ ]] || exit 2
    timedatectl set-ntp false
    timedatectl set-time "$ARG:00"
    ;;
  ora-windows)
    case "$ARG" in
      0|1) timedatectl set-local-rtc "$ARG" --adjust-system-clock ;;
      *) exit 2 ;;
    esac
    ;;
  driver)
    exec /usr/libexec/alba/alba-driver-auto --forza
    ;;
  diagnosi)
    exec /usr/libexec/alba/alba-diagnosi --controlla
    ;;
  ripara)
    [[ "$ARG" =~ ^[a-z0-9-]{1,40}$ ]] || exit 2
    exec /usr/libexec/alba/alba-diagnosi --ripara "$ARG"
    ;;
  installa-cie)
    URL=https://github.com/italia/cie-middleware-linux/releases/download/1.4.3.1/CIE-Middleware-1.4.3-2.amd64.deb
    T="$(mktemp -d)"
    curl -fsSL -o "$T/cie.deb" "$URL" || { rm -rf "$T"; exit 4; }
    apt-get update -q || true
    apt-get install -y -q pcscd libccid opensc "$T/cie.deb"
    esito=$?
    rm -rf "$T"
    exit $esito
    ;;
  installa)
    # Solo pacchetti della lista consentita
    case "$ARG" in
      systemd-timesyncd|corectrl|power-profiles-daemon|brightnessctl|mangohud|pcscd|opensc|pcsc-tools|game-devices-udev|steam-devices) ;;
      *) exit 2 ;;
    esac
    apt-get update -q || true
    apt-get install -y -q "$ARG"
    [ "$ARG" = systemd-timesyncd ] && timedatectl set-ntp true
    ;;
  *)
    echo "Comando non riconosciuto" >&2
    exit 2
    ;;
esac
