    # ---------------------------------------------------------------- widget
    def carica_meteo(self):
        """Meteo della città del fuso orario (nessun dato personale inviato)."""
        import threading
        import json
        import urllib.request

        def posizione():
            tz = os.path.realpath("/etc/localtime").split("zoneinfo/")[-1]
            for riga in leggi("/usr/share/zoneinfo/zone1970.tab").splitlines():
                parti = riga.split("\t")
                if len(parti) >= 3 and parti[2] == tz:
                    import re
                    m = re.match(r"([+-])(\d{2})(\d{2})(\d{0,2})([+-])(\d{3})(\d{2})(\d{0,2})", parti[1])
                    if m:
                        lat = (int(m[2]) + int(m[3]) / 60) * (1 if m[1] == "+" else -1)
                        lon = (int(m[6]) + int(m[7]) / 60) * (1 if m[5] == "+" else -1)
                        citta = tz.split("/")[-1].replace("_", " ")
                        return lat, lon, CITTA.get(citta, citta)
            return None

        def lavoro():
            if PROVA:
                dati = {"current": {"temperature_2m": 14.2, "weather_code": 2},
                        "daily": {"time": ["2026-10-20", "2026-10-21", "2026-10-22", "2026-10-23"],
                                  "weather_code": [2, 61, 3, 0], "temperature_2m_max": [16, 13, 12, 17],
                                  "temperature_2m_min": [8, 9, 7, 6]}}
                GLib.idle_add(self.mostra_meteo, dati, "Zurigo")
                return
            pos = posizione()
            if not pos:
                return
            lat, lon, citta = pos
            url = (f"https://api.open-meteo.com/v1/forecast?latitude={lat:.2f}&longitude={lon:.2f}"
                   "&current=temperature_2m,weather_code&daily=weather_code,temperature_2m_max,temperature_2m_min"
                   "&timezone=auto&forecast_days=4")
            for _ in range(6):   # la rete può arrivare qualche secondo dopo
                try:
                    with urllib.request.urlopen(url, timeout=6) as r:
                        GLib.idle_add(self.mostra_meteo, json.load(r), citta)
                        return
                except (OSError, ValueError):
                    time.sleep(10)
        threading.Thread(target=lavoro, daemon=True).start()

    def mostra_meteo(self, dati, citta):
        try:
            att = dati["current"]
            self.meteo_icona.set_from_icon_name(icona_meteo(att["weather_code"]), Gtk.IconSize.LARGE_TOOLBAR)
            self.meteo_temp.set_text(f"{round(att['temperature_2m'])}°")
            self.meteo_citta.set_text(f"{citta} · {descrizione_meteo(att['weather_code'])}")
            for c in self.previsioni_box.get_children():
                self.previsioni_box.remove(c)
            g = dati["daily"]
            for i in range(1, min(4, len(g["time"]))):
                giorno = time.strptime(g["time"][i], "%Y-%m-%d")
                col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                col.pack_start(Gtk.Label(label=GIORNI[giorno.tm_wday][:3].capitalize()), False, False, 0)
                col.pack_start(Gtk.Image.new_from_icon_name(icona_meteo(g["weather_code"][i]),
                                                            Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
                col.pack_start(Gtk.Label(label=f"{round(g['temperature_2m_max'][i])}° / "
                                               f"{round(g['temperature_2m_min'][i])}°"), False, False, 0)
                self.previsioni_box.pack_start(col, False, False, 0)
            self.previsioni_box.show_all()
            self.meteo.show()
        except (KeyError, TypeError, IndexError, ValueError):
            pass
        return False

    def aggiorna_stato(self):
        rete = "network-offline-symbolic"
        if PROVA:
            rete = "network-wireless-signal-good-symbolic"
        elif os.path.isdir("/sys/class/net"):
            for n in os.listdir("/sys/class/net"):
                if n == "lo" or leggi(f"/sys/class/net/{n}/operstate") != "up":
                    continue
                rete = ("network-wireless-signal-good-symbolic" if os.path.isdir(f"/sys/class/net/{n}/wireless")
                        else "network-wired-symbolic")
                break
        self.stato_rete.set_from_icon_name(rete, Gtk.IconSize.LARGE_TOOLBAR)
        bat = None
        if os.path.isdir("/sys/class/power_supply"):
            for d in sorted(os.listdir("/sys/class/power_supply")):
                if leggi(f"/sys/class/power_supply/{d}/type") == "Battery":
                    bat = d
                    break
        if PROVA:
            livello, stato = 76, "Discharging"
        elif bat:
            livello = int(leggi(f"/sys/class/power_supply/{bat}/capacity", "0") or 0)
            stato = leggi(f"/sys/class/power_supply/{bat}/status")
        else:
            self.stato_bat_icona.hide()
            self.stato_bat.hide()
            return
        carica = "-charging" if stato in ("Charging", "Full") else ""
        self.stato_bat_icona.set_from_icon_name(f"battery-level-{min(100, round(livello / 10) * 10)}{carica}-symbolic",
                                                Gtk.IconSize.LARGE_TOOLBAR)
        self.stato_bat.set_text(f"{livello}%")

    def aggiorna_ora(self):
        adesso = time.localtime()
        self.ora.set_text(time.strftime("%H:%M", adesso))
        self.data.set_text(f"{GIORNI[adesso.tm_wday].capitalize()} {adesso.tm_mday} {MESI[adesso.tm_mon - 1]}")
        return True

    # -------------------------------------------------------------- animazioni
    def entrata(self):
        """All'apertura: orologio e utente salgono piano e compaiono."""
        self.blocco_ora.set_opacity(0)
        self.centro.set_opacity(0)
        alto = self.blocco_ora.get_margin_top()

        def passo(t):
            e = morbido(t)
            for sf in self.sfondi:
                sf.zoom = 1.0 + 0.06 * (1 - e)
                sf.queue_draw()
            self.blocco_ora.set_opacity(e)
            self.blocco_ora.set_margin_top(int(alto + 24 * (1 - e)))
            self.centro.set_opacity(morbido(max(0.0, t * 1.25 - 0.25)))
            self.centro.set_margin_top(int(self.margine_centro + 36 * (1 - e)))
        anima(900, passo, lambda: self.password.grab_focus())

    def scuoti(self):
        """Password sbagliata: il campo fa "no" con la testa, come su macOS."""
        def passo(t):
            spostamento = int(14 * math.sin(t * math.pi * 6) * (1 - t))
            self.riga_password.set_margin_start(max(0, spostamento) * 2)
            self.riga_password.set_margin_end(max(0, -spostamento) * 2)
        anima(420, passo)

    def uscita(self, poi):
        """Accesso riuscito, come su macOS/Windows: "Benvenuto" per un attimo,
        poi orologio e scheda svaniscono mentre lo sfondo sfocato diventa lo
        sfondo nitido del desktop. Il desktop parte da quell'immagine: nessuno
        stacco nero, nessun pezzo che salta fuori."""
        nome = (self.utente.get_display_name() or self.utente.get_name()) if self.utente else ""
        saluto = "Bentornato" if (self.greeter and self.greeter.get_lock_hint()) else "Benvenuto"
        self.nome.set_text(f"{saluto}, {nome.split()[0]}" if nome else saluto)
        self.riga_password.set_opacity(0)
        self.rotella.show()
        self.rotella.start()
        nitido = self.sfondo_desktop()
        for sf in self.sfondi:
            sf.nitido = nitido

        def passo(t):
            e = morbido(t)
            for w in (self.blocco_ora, self.centro):
                w.set_opacity(1 - e)
            if nitido:
                for sf in self.sfondi:
                    sf.misto = e
                    sf.queue_draw()

        def fine():
            self.imposta_sfondo_schermo(nitido)
            poi()
        GLib.timeout_add(450, lambda: (anima(650, passo, fine), False)[1])

    def sfondo_desktop(self):
        """Lo sfondo del desktop dell'utente (lo comunica Alba ad AccountsService)."""
        percorsi = []
        if self.utente is not None and hasattr(self.utente, "get_background"):
            percorsi.append(self.utente.get_background() or "")
        percorsi.append("/usr/share/backgrounds/alba/alba.png")
        for p in percorsi:
            if p and os.path.isfile(p):
                try:
                    return GdkPixbuf.Pixbuf.new_from_file(p)
                except GLib.Error:
                    continue
        return None

    @staticmethod
    def imposta_sfondo_schermo(pix):
        """Mette lo sfondo del desktop anche "sotto" le finestre: mentre il
        desktop si carica si vede quello, non uno schermo nero."""
        if pix is None:
            return
        try:
            radice = Gdk.get_default_root_window()
            L, A = radice.get_width(), radice.get_height()
            superficie = radice.create_similar_surface(__import__("cairo").CONTENT_COLOR, L, A)
            cr = __import__("cairo").Context(superficie)
            img = Sfondo.copri(pix, L, A)
            Gdk.cairo_set_source_pixbuf(cr, img, (L - img.get_width()) / 2, (A - img.get_height()) / 2)
            cr.paint()
            radice.set_background_pattern(__import__("cairo").SurfacePattern(superficie))
            Gdk.flush()
        except Exception:  # noqa: BLE001 - è solo un abbellimento
            pass

    # ------------------------------------------------------------------ utenti
    def utente_iniziale(self):
        nomi = {u.get_name(): u for u in self.utenti}
        for candidato in ((self.greeter.get_select_user_hint() if self.greeter else None), leggi(MEMORIA)):
            if candidato and candidato in nomi:
                return nomi[candidato]
        return self.utenti[0] if self.utenti else None

    def scegli_utente(self, utente, animazione=True):
        if utente is None:
            self.nome.set_text("Nessun utente")
            return
        self.utente = utente
        for c in self.posto_foto.get_children():
            self.posto_foto.remove(c)
        foto = Foto(utente, 116)
        self.posto_foto.pack_start(foto, False, False, 0)
        foto.show()
        self.nome.set_text(utente.get_display_name() or utente.get_name())
        for n, b in self.bottoni_utente.items():
            ctx = b.get_style_context()
            (ctx.add_class if n == utente.get_name() else ctx.remove_class)("scelto")
        self.password.set_text("")
        self.mostra_messaggio("")
        if animazione:
            self.centro.set_opacity(0)
            anima(260, lambda t: self.centro.set_opacity(morbido(t)))
        self.avvia_autenticazione()
        self.password.grab_focus()

    def avvia_autenticazione(self):
        if PROVA or not self.utente:
            return
        if self.greeter.get_in_authentication():
            self.greeter.cancel_authentication()
        self.greeter.authenticate(self.utente.get_name())

    # ------------------------------------------------------------ LightDM
    def chiede(self, _g, testo, tipo):
        # PAM chiede la password (o un altro dato): il campo è già pronto
        self.in_corso = False
        (self.rotella.stop(), self.rotella.hide())
        self.password.set_sensitive(True)
        segreto = tipo == LightDM.PromptType.SECRET
        self.password.set_visibility(not segreto)
        if not segreto and testo:
            self.password.set_placeholder_text(testo.strip().rstrip(":"))
        else:
            self.password.set_placeholder_text("Password")
        self.password.grab_focus()

    def messaggio_pam(self, _g, testo, _tipo):
        self.mostra_messaggio(testo)

    def completato(self, greeter):
        (self.rotella.stop(), self.rotella.hide())
        self.in_corso = False
        if greeter.get_is_authenticated():
            try:
                os.makedirs(os.path.dirname(MEMORIA), exist_ok=True)
                with open(MEMORIA, "w", encoding="utf-8") as f:
                    f.write(self.utente.get_name())
            except OSError:
                pass
            sessione = self.utente.get_session() or greeter.get_default_session_hint()

            def avvia():
                try:
                    greeter.start_session_sync(sessione)
                except GLib.Error:
                    greeter.start_session_sync(None)
                Gtk.main_quit()
            self.uscita(avvia)
        else:
            self.password.set_text("")
            self.password.set_sensitive(True)
            self.mostra_messaggio("Password errata. Riprova.")
            self.scuoti()
            self.avvia_autenticazione()

    def invia(self):
        if self.in_corso:
            return
        testo = self.password.get_text()
        if PROVA:
            if testo == "alba":
                self.uscita(Gtk.main_quit)
            else:
                self.mostra_messaggio("Password errata. Riprova.")
                self.scuoti()
            return
        if not self.greeter.get_in_authentication():
            self.avvia_autenticazione()
        self.in_corso = True
        self.password.set_sensitive(False)
        (self.rotella.show(), self.rotella.start())
        self.greeter.respond(testo)

    def energia(self, azione):
        if PROVA:
            return
        try:
            {"suspend": LightDM.suspend, "restart": LightDM.restart, "shutdown": LightDM.shutdown}[azione]()
        except GLib.Error as e:
            self.mostra_messaggio(f"Non riuscito: {e.message}")

    def mostra_messaggio(self, testo):
        if not testo and self.password.get_visibility() is False:
            caps = Gdk.Keymap.get_for_display(Gdk.Display.get_default()).get_caps_lock_state()
            testo = "Il blocco maiuscole è attivo" if caps and self.password.get_text() else ""
        self.messaggio.set_text(testo)
        self.messaggio.set_visible(bool(testo))   # niente spazio vuoto nella scheda

    def tasto(self, _w, evento):
        if not self.password.has_focus() and self.password.get_sensitive():
            self.password.grab_focus()
        GLib.idle_add(lambda: self.mostra_messaggio(self.messaggio.get_text()
                                                    if "Riprova" in self.messaggio.get_text() else ""))
        return False


