#!/bin/bash
# Alba Linux - applica il nuovo aspetto di Alba all'utente corrente.
# Con --se-serve lo fa solo se l'aspetto è cambiato dall'ultima volta
# (per non cancellare le personalizzazioni a ogni aggiornamento).
set -u
VERSIONE_ASPETTO=13
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/alba"
MARCA="$CONF/aspetto-versione"
mkdir -p "$CONF"
ATTUALE="$(cat "$MARCA" 2>/dev/null || echo 0)"

if [ "${1:-}" = "--se-serve" ] && [ "$ATTUALE" -ge "$VERSIONE_ASPETTO" ]; then exit 0; fi
[ -n "${DISPLAY:-}" ] || exit 0
pgrep -u "$(id -u)" -x xfce4-session >/dev/null || [ "${1:-}" = "--forza" ] || exit 0

# Mantieni la scelta chiaro/scuro dell'utente (predefinito: scuro)
TEMA="$(cat "$CONF/tema" 2>/dev/null)"
if [ -z "$TEMA" ]; then
  case "$(xfconf-query -c xsettings -p /Net/ThemeName 2>/dev/null)" in
    *[Ll]ight*) TEMA=chiaro ;;
    Arc|Adwaita|Materia) TEMA=chiaro ;;
    *) TEMA=chiaro ;;
  esac
fi
# 1.2, nuova grafica: si parte una volta dal tema chiaro con vetro (scelta di
# Alba); poi resta quello che l'utente sceglie in Impostazioni.
if [ "$ATTUALE" -lt 13 ]; then TEMA=chiaro; fi

# Utente nuovo: i file sono già quelli giusti, basta scegliere il tema
if [ ! -f "$CONF/primo-avvio-v1" ] && [ "${1:-}" != "--forza" ]; then
  /usr/bin/alba-tema "$TEMA"
  echo "$VERSIONE_ASPETTO" > "$MARCA"
  exit 0
fi

SKEL=/etc/skel/.config
X="$HOME/.config/xfce4/xfconf/xfce-perchannel-xml"
mkdir -p "$X" "$HOME/.config/xfce4/panel" "$HOME/.config/autostart" "$HOME/.config/Thunar"

# Ferma barra e configurazione, sostituisci i file, riavvia
xfce4-panel --quit >/dev/null 2>&1
sleep 1
pkill -u "$(id -u)" -x xfconfd 2>/dev/null
pkill -u "$(id -u)" -x nm-applet 2>/dev/null
sleep 0.5
for f in xfce4-panel.xml xsettings.xml xfwm4.xml xfce4-power-manager.xml thunar.xml xfce4-notifyd.xml; do
  [ -f "$SKEL/xfce4/xfconf/xfce-perchannel-xml/$f" ] && cp "$SKEL/xfce4/xfconf/xfce-perchannel-xml/$f" "$X/$f"
done
# niente messaggi d'errore se manca qualche componente della barra
/usr/libexec/alba/alba-pulisci-barra "$X/xfce4-panel.xml" >/dev/null 2>&1
rm -f "$HOME"/.config/xfce4/panel/whiskermenu-*.rc "$HOME"/.config/xfce4/panel/docklike-*.rc "$HOME"/.config/xfce4/panel/genmon-*.rc
cp "$SKEL"/xfce4/panel/*.rc "$HOME/.config/xfce4/panel/"
cp "$SKEL"/autostart/*.desktop "$HOME/.config/autostart/" 2>/dev/null
cp "$SKEL/Thunar/uca.xml" "$HOME/.config/Thunar/uca.xml" 2>/dev/null

setsid -f xfsettingsd --replace >/dev/null 2>&1
sleep 1
/usr/bin/alba-tema "$TEMA"
XFCE_PANEL_NO_RESTART=1 /usr/bin/alba-barra "$TEMA" >/dev/null 2>&1
setsid -f xfwm4 --replace >/dev/null 2>&1
setsid -f xfce4-panel >/dev/null 2>&1
pgrep -u "$(id -u)" -f "python3 /usr/bin/alba-barra-alta" >/dev/null || setsid -f /usr/bin/python3 /usr/bin/alba-barra-alta >/dev/null 2>&1
pgrep -u "$(id -u)" -f "python3 /usr/bin/alba-app" >/dev/null || setsid -f /usr/bin/python3 /usr/bin/alba-app --sfondo >/dev/null 2>&1

# Scorciatoie aggiornate (Impostazioni e Gestione attività)
for k in "<Super>i=alba-impostazioni" "<Primary><Shift>Escape=alba-gestione-attivita" "<Primary><Alt>Delete=alba-gestione-attivita" \
         "XF86AudioRaiseVolume=alba-volume su" "XF86AudioLowerVolume=alba-volume giu" "XF86AudioMute=alba-volume muto" \
         "<Super>a=alba-rapido controlli" "<Super>n=alba-rapido notifiche" "<Super>x=alba-menu-x" \
         "XF86MonBrightnessUp=alba-luminosita su" "XF86MonBrightnessDown=alba-luminosita giu" \
         "Super_L=alba-app" "Super_R=alba-app" "<Super>l=alba-blocco --ora"; do
  xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/${k%%=*}" -n -t string -s "${k#*=}" 2>/dev/null || \
  xfconf-query -c xfce4-keyboard-shortcuts -p "/commands/custom/${k%%=*}" -s "${k#*=}" 2>/dev/null
done

echo "$VERSIONE_ASPETTO" > "$MARCA"
if [ "$ATTUALE" -gt 0 ] || [ -f "$CONF/primo-avvio-v1" ]; then
  notify-send -a "Alba" -i alba-logo "Benvenuto nella nuova Alba" \
    "Barra in alto, Dock e tutte le app col logo di Alba o col tasto Windows. Le opzioni sono in Impostazioni > Aspetto." 2>/dev/null
fi
exit 0
