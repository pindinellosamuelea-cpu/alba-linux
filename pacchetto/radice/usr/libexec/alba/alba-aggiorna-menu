#!/usr/bin/python3
"""Alba Linux - riordina il menu Start.

Crea in /usr/local/share/applications delle versioni "Alba" di alcune voci:
 - gli strumenti tecnici finiscono nella cartella "Strumenti avanzati";
 - giochi ed editor partono sulla scheda grafica dedicata;
 - alcune voci vengono rinominate (es. "Install Debian" -> "Installa Alba").
I file originali non vengono toccati: se un programma si aggiorna, questo
script viene rieseguito in automatico (trigger di dpkg).
"""
import configparser
import fnmatch
import glob
import os

ORIGINE = "/usr/share/applications"
DEST = "/usr/local/share/applications"
SEGNO = "X-Alba-Generato"
GPU = "/usr/bin/alba-gpu-dedicata"

AVANZATI = [
    "htop", "gparted", "*xterm", "debian-*xterm", "vim", "nvim", "gvim", "im-config",
    "org.gnome.DiskUtility", "gnome-disks", "xfce4-taskmanager", "org.xfce.taskmanager",
    "lightdm-gtk-greeter-settings", "menulibre", "catfish", "org.xfce.Catfish", "clamtk",
    "gufw", "nm-connection-editor", "blueman-manager", "blueman-adapters", "pavucontrol",
