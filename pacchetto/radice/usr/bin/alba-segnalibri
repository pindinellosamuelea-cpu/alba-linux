#!/bin/bash
# Alba Linux - cartelle principali nella barra laterale di Esplora file,
# come su Windows: Desktop, Download, Documenti, Immagini, Musica, Video.
set -u
F="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/bookmarks"
mkdir -p "$(dirname "$F")"
command -v xdg-user-dirs-update >/dev/null && xdg-user-dirs-update >/dev/null 2>&1
grep -q "# alba" "$F" 2>/dev/null && [ "${1:-}" != "--forza" ] && exit 0
TMP="$(mktemp)"
for d in DESKTOP DOWNLOAD DOCUMENTS PICTURES MUSIC VIDEOS; do
  p="$(xdg-user-dir "$d" 2>/dev/null)"
  [ -n "$p" ] && [ "$p" != "$HOME" ] && [ -d "$p" ] || continue
  printf 'file://%s %s\n' "$(python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1]))' "$p")" "$(basename "$p")" >> "$TMP"
done
# Mantieni i segnalibri aggiunti dall'utente
[ -f "$F" ] && grep -v -F -f <(cut -d' ' -f1 "$TMP") "$F" | grep -v "# alba" >> "$TMP"
echo "# alba" >> "$TMP"
mv "$TMP" "$F"
