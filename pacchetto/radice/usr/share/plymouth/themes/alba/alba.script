# Alba Linux - schermata di avvio
# Sfondo notturno, logo al centro e cinque punti che "respirano" sotto.

Window.SetBackgroundTopColor(0.043, 0.059, 0.161);
Window.SetBackgroundBottomColor(0.114, 0.090, 0.231);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(cx - logo.image.GetWidth() / 2);
logo.sprite.SetY(cy - logo.image.GetHeight() / 2 - 30);
logo.sprite.SetZ(10);

punto.image = Image("punto.png");
spazio = 26;
base_y = cy + logo.image.GetHeight() / 2 + 20;
for (i = 0; i < 5; i++) {
  punti[i] = Sprite(punto.image);
  punti[i].SetX(cx + (i - 2) * spazio - punto.image.GetWidth() / 2);
  punti[i].SetY(base_y);
  punti[i].SetZ(10);
  punti[i].SetOpacity(0.25);
}

tempo = 0;
logo.sprite.SetOpacity(0);
fun aggiorna() {
  tempo++;
  # il logo compare dolcemente (circa mezzo secondo)
  if (tempo <= 25) logo.sprite.SetOpacity(tempo / 25);
  for (i = 0; i < 5; i++) {
    o = 0.5 + 0.5 * Math.Sin(tempo * 0.09 - i * 0.8);
    punti[i].SetOpacity(0.2 + 0.8 * o * o);
  }
}
Plymouth.SetRefreshFunction(aggiorna);

# --- Spegnimento e riavvio: stesso logo, con una scritta sobria ------------
modo = Plymouth.GetMode();
stato.sprite = Sprite();
stato.sprite.SetZ(15);
if (modo == "shutdown" || modo == "reboot") {
  if (modo == "shutdown") stato.testo = "Spegnimento in corso";
  else stato.testo = "Riavvio in corso";
  st = Image.Text(stato.testo, 0.93, 0.9, 0.95, 1, "Sans 12");
  stato.sprite.SetImage(st);
  stato.sprite.SetX(cx - st.GetWidth() / 2);
  stato.sprite.SetY(base_y + 34);
  stato.sprite.SetOpacity(0.85);
}

# --- Richiesta password (es. disco cifrato) -------------------------------
messaggio.sprite = Sprite();
messaggio.sprite.SetZ(20);

fun mostra_password(prompt, simboli) {
  testo = prompt + "  ";
  for (i = 0; i < simboli; i++) testo = testo + "•";
  img = Image.Text(testo, 1, 0.94, 0.9);
  messaggio.sprite.SetImage(img);
  messaggio.sprite.SetX(cx - img.GetWidth() / 2);
  messaggio.sprite.SetY(base_y + 50);
  messaggio.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(mostra_password);

fun nascondi_messaggio() {
  messaggio.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(nascondi_messaggio);

fun mostra_messaggio(testo) {
  img = Image.Text(testo, 1, 0.94, 0.9);
  messaggio.sprite.SetImage(img);
  messaggio.sprite.SetX(cx - img.GetWidth() / 2);
  if (agg.attivo) messaggio.sprite.SetY(base_y + 132);
  else messaggio.sprite.SetY(base_y + 50);
  messaggio.sprite.SetOpacity(1);
}
Plymouth.SetMessageFunction(mostra_messaggio);

# --- Aggiornamento al riavvio ("Sto applicando l'aggiornamento") -----------
agg.attivo = 0;
agg.titolo = Sprite();
agg.titolo.SetZ(20);
agg.vuota = Sprite(Image("barra-vuota.png"));
agg.vuota.SetZ(20);
agg.vuota.SetOpacity(0);
barra_piena_img = Image("barra-piena.png");
agg.piena = Sprite();
agg.piena.SetZ(21);
agg.perc = Sprite();
agg.perc.SetZ(20);

fun mostra_aggiornamento(progresso) {
  if (!agg.attivo) {
    agg.attivo = 1;
    t = Image.Text("Sto applicando l'aggiornamento", 1, 1, 1, 1, "Sans Bold 15");
    agg.titolo.SetImage(t);
    agg.titolo.SetX(cx - t.GetWidth() / 2);
    agg.titolo.SetY(base_y + 48);
    agg.vuota.SetX(cx - 160);
    agg.vuota.SetY(base_y + 88);
    agg.vuota.SetOpacity(1);
  }
  larghezza = Math.Int(320 * progresso / 100);
  if (larghezza < 6) larghezza = 6;
  agg.piena.SetImage(barra_piena_img.Scale(larghezza, 6));
  agg.piena.SetX(cx - 160);
  agg.piena.SetY(base_y + 88);
  p = Image.Text("" + Math.Int(progresso) + "%  ·  non spegnere il computer", 0.85, 0.85, 0.9, 1, "Sans 11");
  agg.perc.SetImage(p);
  agg.perc.SetX(cx - p.GetWidth() / 2);
  agg.perc.SetY(base_y + 104);
  # i messaggi (es. "Tolgo i file della versione vecchia") vanno sotto la barra
  messaggio.sprite.SetY(base_y + 132);
}
Plymouth.SetSystemUpdateFunction(mostra_aggiornamento);
