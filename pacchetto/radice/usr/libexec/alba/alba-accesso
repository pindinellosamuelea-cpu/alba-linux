def leggi(percorso, predefinito=""):
    try:
        with open(percorso, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return predefinito


def tema():
    conf = {}
    for riga in leggi("/usr/share/alba/tema.conf").splitlines():
        if "=" in riga:
            k, v = riga.split("=", 1)
            conf[k.strip()] = v.strip().strip('"')
    return conf


def morbido(t):
    """Curva ease-out: parte veloce, arriva piano."""
    return 1 - (1 - t) ** 3


def anima(durata_ms, passo, fine=None):
    """Chiama passo(t) con t da 0 a 1 per la durata indicata."""
    inizio = time.monotonic()

    def tic():
        t = min(1.0, (time.monotonic() - inizio) * 1000 / durata_ms)
        passo(t)
        if t >= 1.0:
            if fine:
                fine()
            return False
        return True
    GLib.timeout_add(16, tic)


