    def _foto_da_file(self):
        d = Gtk.FileChooserDialog(title="Scegli una foto", transient_for=self, action=Gtk.FileChooserAction.OPEN)
        d.add_buttons("Annulla", Gtk.ResponseType.CANCEL, "Usa questa foto", Gtk.ResponseType.ACCEPT)
        f = Gtk.FileFilter()
        f.set_name("Immagini")
        f.add_mime_type("image/*")
        d.add_filter(f)
        if d.run() == Gtk.ResponseType.ACCEPT:
            self._scegli_foto(d.get_filename())
            if hasattr(self, "_nessuna"):
                self._nessuna.set_active(True)
        d.destroy()

    def _disegna_foto(self, w, cr):
        l = w.get_allocated_width()
        cr.arc(l / 2, l / 2, l / 2, 0, 6.2832)
        pix = None
        if self.foto_scelta:
            try:
                pix = quadrata(GdkPixbuf.Pixbuf.new_from_file(self.foto_scelta), l)
            except GLib.Error:
                pix = None
        if pix:
            cr.save()
            cr.clip()
            Gdk.cairo_set_source_pixbuf(cr, pix, 0, 0)
            cr.paint()
            cr.restore()
        else:
            cr.set_source_rgb(0.94, 0.48, 0.12)
            cr.fill()
            iniziale = (self.nome.get_text().strip()[:1] if hasattr(self, "nome") else "") or "?"
            cr.set_source_rgb(1, 1, 1)
            cr.select_font_face("Inter", 0, 1)
            cr.set_font_size(l * 0.45)
            e = cr.text_extents(iniziale.upper())
            cr.move_to(l / 2 - e.width / 2 - e.x_bearing, l / 2 - e.height / 2 - e.y_bearing)
            cr.show_text(iniziale.upper())
        return False

