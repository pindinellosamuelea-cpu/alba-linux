    @staticmethod
    def ripara():
        esegui(["rfkill", "unblock", "bluetooth"])
        esegui(["systemctl", "restart", "bluetooth"], 30)


FIRMWARE = ["firmware-linux-nonfree", "firmware-misc-nonfree", "firmware-iwlwifi", "firmware-realtek",
            "firmware-atheros", "firmware-brcm80211", "firmware-mediatek", "firmware-amd-graphics",
            "firmware-intel-graphics", "firmware-nvidia-graphics", "firmware-sof-signed", "bluez-firmware"]


@problema("firmware", "Manca un componente per un dispositivo",
          "Un dispositivo (Wi-Fi, Bluetooth, audio o scheda grafica) non ha il firmware che gli serve per funzionare.")
class Firmware:
    @staticmethod
    def mancanti():
        testo = esegui(["dmesg"], 10)[1] + esegui(["journalctl", "-k", "-b", "--no-pager", "-o", "cat"], 30)[1]
        nomi = set(re.findall(r"firmware: failed to load ([^\s(]+)", testo))
        nomi |= set(re.findall(r"Direct firmware load for ([^\s]+) failed", testo))
        return sorted(n for n in nomi if not os.path.exists(f"/lib/firmware/{n}") and not os.path.exists(f"/usr/lib/firmware/{n}"))

    @staticmethod
    def controllo():
        m = Firmware.mancanti()
        return (True, "manca: " + ", ".join(m[:4])) if m else (False, "")

    @staticmethod
    def ripara():
        esegui(["/usr/libexec/alba/alba-fonti-debian"])
        esegui(["apt-get", "update", "-q"], 300)
        for p in FIRMWARE:
            esegui(APT + ["install", p], 900)
        esegui(["update-initramfs", "-u"], 900)

    # la verifica vera avviene al riavvio: il controllo guarda i file installati


# ---------------------------------------------------------------------------
# Regole online: riconoscono messaggi d'errore nel registro di sistema e li
# collegano ai problemi qui sopra (o mostrano una spiegazione chiara)
# ---------------------------------------------------------------------------
def carica_regole(scarica=False):
    if scarica:
        try:
            if not os.path.exists(REGOLE_ONLINE) or time.time() - os.path.getmtime(REGOLE_ONLINE) > 86400:
                with urllib.request.urlopen(URL_REGOLE, timeout=15) as r:
                    dati = json.loads(r.read().decode())
                if isinstance(dati.get("regole"), list):
                    with open(REGOLE_ONLINE, "w") as f:
                        json.dump(dati, f)
        except Exception:  # noqa: BLE001 - senza Internet si usano le regole già presenti
            pass
    for p in (REGOLE_ONLINE, REGOLE_LOCALI):
        try:
            dati = json.loads(leggi(p))
            if isinstance(dati.get("regole"), list):
                return dati["regole"]
        except (ValueError, AttributeError):
            continue
    return []


def errori_registro():
    testo = esegui(["journalctl", "-b", "-p", "4", "--no-pager", "-o", "cat", "-n", "2000"], 30)[1]
    testo += esegui(["dmesg", "--level=err,warn"], 10)[1]
    return testo


def controlla(scarica=False):
    trovati = []
    for p in PROBLEMI.values():
        try:
            presente, dettaglio = p["controllo"]()
        except Exception as ex:  # noqa: BLE001
            presente, dettaglio = False, f"controllo non riuscito: {ex}"
        if presente:
            trovati.append(dict(id=p["id"], titolo=p["titolo"], spiegazione=p["spiegazione"],
                                dettaglio=dettaglio, risolvibile=True, auto=p["auto"], gravita=p["gravita"]))
    # Regole online sui messaggi d'errore
    registro = errori_registro()
    gia = {t["id"] for t in trovati}
    for regola in carica_regole(scarica):
        try:
            if not re.search(regola["cerca"], registro, re.I | re.M):
                continue
        except (re.error, KeyError, TypeError):
            continue
        collegato = regola.get("problema")
        if collegato in PROBLEMI:
            if collegato in gia:
                continue
            presente, dettaglio = PROBLEMI[collegato]["controllo"]()
            if not presente:
                continue
            p = PROBLEMI[collegato]
            trovati.append(dict(id=p["id"], titolo=p["titolo"], spiegazione=regola.get("spiegazione") or p["spiegazione"],
                                dettaglio=dettaglio, risolvibile=True, auto=p["auto"], gravita=p["gravita"]))
            gia.add(collegato)
        elif regola.get("titolo") and regola.get("id") not in gia:
            trovati.append(dict(id=regola.get("id", "regola"), titolo=regola["titolo"],
                                spiegazione=regola.get("spiegazione", ""), dettaglio="", risolvibile=False,
                                auto=False, gravita=regola.get("gravita", "bassa")))
            gia.add(regola.get("id"))
    return trovati


def ripara(id_):
    if id_ not in PROBLEMI:
        return dict(id=id_, risolto=False, dettaglio="Problema sconosciuto")
    p = PROBLEMI[id_]
    try:
        p["ripara"]()
    except Exception as ex:  # noqa: BLE001
        return dict(id=id_, risolto=False, dettaglio=f"Riparazione non riuscita: {ex}")
    presente, dettaglio = p["controllo"]()   # verifica: il problema c'è ancora?
    risolto = not presente
    if id_ == "driver-nvidia" and os.path.exists(os.path.join(STATO, "driver-riavvio")):
        risolto, dettaglio = True, "Driver installato: riavvia il computer per attivarlo"
    registra(id_, p["titolo"], risolto, dettaglio)
    return dict(id=id_, risolto=risolto, dettaglio=dettaglio)


def registra(id_, titolo, risolto, dettaglio):
    os.makedirs(STATO, exist_ok=True)
    with open(REGISTRO, "a") as f:
        f.write(json.dumps(dict(ora=int(time.time()), id=id_, titolo=titolo, risolto=risolto,
                                dettaglio=dettaglio)) + "\n")
    # tieni il registro piccolo
    righe = leggi(REGISTRO).splitlines()
    if len(righe) > 200:
        with open(REGISTRO, "w") as f:
            f.write("\n".join(righe[-200:]) + "\n")


def automatico():
    """In sottofondo: ripara da solo solo i problemi marcati come sicuri."""
    for t in controlla(scarica=True):
        if t["auto"] and t["risolvibile"]:
            ripara(t["id"])
    with open(os.path.join(STATO, "diagnosi.json"), "w") as f:
        json.dump(dict(ora=int(time.time()), problemi=controlla()), f)


if __name__ == "__main__":
    if os.geteuid() != 0:
        print(json.dumps({"errore": "servono i permessi di amministratore"}))
        sys.exit(1)
    if len(sys.argv) >= 2 and sys.argv[1] == "--controlla":
        print(json.dumps(controlla(scarica=True), ensure_ascii=False))
    elif len(sys.argv) >= 3 and sys.argv[1] == "--ripara" and re.fullmatch(r"[a-z0-9-]{1,40}", sys.argv[2]):
        print(json.dumps(ripara(sys.argv[2]), ensure_ascii=False))
    elif len(sys.argv) >= 2 and sys.argv[1] == "--auto":
        automatico()
    else:
        print(__doc__)
        sys.exit(2)
