#!/bin/bash
# Alba Linux - avvia un programma sulla scheda grafica dedicata.
# Sui PC con due schede (integrata + dedicata, tipico dei portatili da
# gaming) Linux usa di base quella integrata per risparmiare batteria.
# Questo comando fa usare la dedicata a giochi, .exe ed editor video/3D.
# Con una sola scheda non cambia nulla.
#
# Uso: alba-gpu-dedicata programma [argomenti…]
set -u

[ $# -eq 0 ] && { echo "Uso: alba-gpu-dedicata programma [argomenti…]"; exit 1; }

# Conta le schede grafiche presenti
SCHEDE=$(ls -d /sys/class/drm/card[0-9]* 2>/dev/null | grep -Ev -- '-' | wc -l)

if [ "$SCHEDE" -gt 1 ]; then
  if lsmod 2>/dev/null | grep -q '^nvidia '; then
    # Driver NVIDIA ufficiale (PRIME render offload)
    export __NV_PRIME_RENDER_OFFLOAD=1
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export __VK_LAYER_NV_optimus=NVIDIA_only
  else
    # Driver liberi Mesa: AMD, Intel Arc, NVIDIA con nouveau
    export DRI_PRIME=1
  fi
fi

# FPS e temperature nei giochi, se attivati nelle Impostazioni
[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/alba/mangohud" ] && export MANGOHUD=1

exec "$@"
