#!/usr/bin/python3
"""Alba Linux - prepara Steam per i giochi Windows, una volta sola:
  - Proton Experimental come predefinito per tutti i giochi Windows
    (come attivare "Steam Play per tutti gli altri titoli");
  - shader Vulkan elaborati con tutti i core del processore.
Va eseguito quando Steam è chiuso (all'accesso, prima di aprirlo)."""
import os
import re
import subprocess

for base in (os.path.expanduser("~/.steam/steam"), os.path.expanduser("~/.local/share/Steam")):
    if not os.path.isdir(base):
        continue
    dev = os.path.join(base, "steam_dev.cfg")
    if not os.path.exists(dev):
        with open(dev, "w") as f:
            f.write(f"unShaderBackgroundProcessingThreads {os.cpu_count() or 4}\n")
    conf = os.path.join(base, "config", "config.vdf")
    if not os.path.exists(conf):
        continue
    if subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "steam"], capture_output=True).returncode == 0:
        continue  # Steam aperto: riproveremo al prossimo accesso
    testo = open(conf, encoding="utf-8", errors="replace").read()
    if re.search(r'"CompatToolMapping"\s*\{\s*"0"', testo):
        continue  # l'utente ha già scelto
    voce = ('\t\t\t\t"CompatToolMapping"\n\t\t\t\t{\n\t\t\t\t\t"0"\n\t\t\t\t\t{\n'
            '\t\t\t\t\t\t"name"\t\t"proton_experimental"\n\t\t\t\t\t\t"config"\t\t""\n'
            '\t\t\t\t\t\t"priority"\t\t"75"\n\t\t\t\t\t}\n\t\t\t\t}\n')
    if '"CompatToolMapping"' in testo:
        nuovo = re.sub(r'("CompatToolMapping"\s*\{)', r'\1\n\t\t\t\t\t"0"\n\t\t\t\t\t{\n\t\t\t\t\t\t"name"\t\t"proton_experimental"\n'
                       r'\t\t\t\t\t\t"config"\t\t""\n\t\t\t\t\t\t"priority"\t\t"75"\n\t\t\t\t\t}', testo, count=1)
    else:
        m = re.search(r'"Steam"\s*\{', testo)
        if not m:
            continue
        nuovo = testo[:m.end()] + "\n" + voce + testo[m.end():]
    os.replace(conf, conf + ".prima-di-alba")
    with open(conf, "w", encoding="utf-8") as f:
        f.write(nuovo)
