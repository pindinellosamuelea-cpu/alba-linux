/* Alba Linux 1.2 - installer chiaro con l'arancio di Alba */
QWidget { font-family: "Inter", "Noto Sans"; font-size: 11pt; color: #2a2018; }
#mainApp, QDialog { background-color: #fbf7f3; }
#sidebarApp, #sidebarMenuApp { background-color: #f3ebe3; }
QPushButton {
  background-color: #ffffff; border: 1px solid #e6d9cd; border-radius: 10px; padding: 8px 18px; min-height: 22px;
}
QPushButton:hover { background-color: #fff3e8; border-color: #f0b07a; }
QPushButton:pressed { background-color: #fde3cc; }
QPushButton:disabled { color: #b8aca0; background-color: #f6f1ec; }
QPushButton#view-button-next, QPushButton#view-button-install {
  background-color: #f07a1e; color: #ffffff; border: none; font-weight: 600;
}
QPushButton#view-button-next:hover, QPushButton#view-button-install:hover { background-color: #e06a10; }
QComboBox, QLineEdit, QSpinBox {
  background-color: #ffffff; border: 1px solid #e6d9cd; border-radius: 8px; padding: 5px 10px; min-height: 22px;
}
QComboBox:focus, QLineEdit:focus { border-color: #f07a1e; }
QRadioButton::indicator:checked, QCheckBox::indicator:checked { background-color: #f07a1e; border: 1px solid #f07a1e; border-radius: 4px; }
QProgressBar { background-color: #efe4da; border: none; border-radius: 6px; height: 12px; text-align: center; color: transparent; }
QProgressBar::chunk { background-color: #f07a1e; border-radius: 6px; }
QListView, QTreeView { background-color: #ffffff; border: 1px solid #e6d9cd; border-radius: 8px; selection-background-color: #fde3cc; selection-color: #2a2018; }
