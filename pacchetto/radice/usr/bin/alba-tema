#!/bin/bash
# Alba Linux - passa dal tema chiaro a quello scuro (e viceversa).
# Uso: alba-tema chiaro|scuro
set -u
. /usr/share/alba/tema.conf 2>/dev/null
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/alba"
mkdir -p "$CONF"

esiste() { [ -d "/usr/share/themes/$1/gtk-3.0" ] || [ -d "$HOME/.themes/$1/gtk-3.0" ]; }

case "${1:-}" in
  scuro)  T="${TEMA_SCURO:-}";  RISERVA="Materia-dark Arc-Dark Adwaita-dark"; ICONE="${ICONE_SCURO:-Papirus-Dark}"; SCURO=true;  SCHEMA=prefer-dark ;;
  chiaro) T="${TEMA_CHIARO:-}"; RISERVA="Materia-light Arc Adwaita";          ICONE="${ICONE_CHIARO:-Papirus}";     SCURO=false; SCHEMA=prefer-light ;;
  *) echo "Uso: alba-tema chiaro|scuro"; exit 1 ;;
esac
[ -d "/usr/share/icons/$ICONE" ] || { [ "$SCURO" = true ] && ICONE=Papirus-Dark || ICONE=Papirus; }
if [ -z "$T" ] || ! esiste "$T"; then
  for r in $RISERVA; do esiste "$r" && { T="$r"; break; }; done
fi

imposta() { xfconf-query -c "$1" -p "$2" -n -t "$3" -s "$4" 2>/dev/null || xfconf-query -c "$1" -p "$2" -s "$4" 2>/dev/null; }

imposta xsettings /Net/ThemeName string "$T"
imposta xsettings /Net/IconThemeName string "$ICONE"
# La barra resta sempre scura (come il Dock del Mac): leggibile con entrambi i temi
imposta xfce4-panel /panels/dark-mode bool true
# Colore della barra (lo usa anche per le icone di sistema, così è uniforme)
RGBA="0.118 0.122 0.169 1"
xfconf-query -c xfce4-panel -p /panels/panel-1/background-style -n -t uint -s 1 2>/dev/null || \
  xfconf-query -c xfce4-panel -p /panels/panel-1/background-style -s 1 2>/dev/null
set -- $RGBA
xfconf-query -c xfce4-panel -p /panels/panel-1/background-rgba -n -t double -s "$1" -t double -s "$2" -t double -s "$3" -t double -s "$4" 2>/dev/null || \
  xfconf-query -c xfce4-panel -p /panels/panel-1/background-rgba -t double -s "$1" -t double -s "$2" -t double -s "$3" -t double -s "$4" 2>/dev/null
if [ -d "/usr/share/themes/$T/xfwm4" ]; then
  imposta xfwm4 /general/theme string "$T"
elif [ "$SCURO" = true ] && [ -d /usr/share/themes/Arc-Dark/xfwm4 ]; then
  imposta xfwm4 /general/theme string Arc-Dark
elif [ -d /usr/share/themes/Arc/xfwm4 ]; then
  imposta xfwm4 /general/theme string Arc
fi

# App moderne (GTK4, es. Negozio di app)
if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface color-scheme "$SCHEMA" 2>/dev/null
  gsettings set org.gnome.desktop.interface gtk-theme "$T" 2>/dev/null
  gsettings set org.gnome.desktop.interface icon-theme "$ICONE" 2>/dev/null
fi
echo "$1" > "$CONF/tema"
