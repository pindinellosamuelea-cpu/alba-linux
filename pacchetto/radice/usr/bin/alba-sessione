#!/bin/bash
# Alba Linux - avviato a ogni accesso, in silenzio e con poca memoria.
set -u
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/alba"
mkdir -p "$CONF"

# 1. Agente per le richieste di password (finestra "inserisci la password")
if ! pgrep -u "$(id -u)" -f 'polkit-gnome-authentication-agent|polkit-mate-authentication-agent|lxpolkit|xfce-polkit|polkit-kde-authentication' >/dev/null; then
  for a in /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
           /usr/libexec/polkit-gnome-authentication-agent-1 \
           /usr/libexec/polkit-mate-authentication-agent-1 \
           /usr/lib/x86_64-linux-gnu/polkit-mate/polkit-mate-authentication-agent-1 \
           /usr/bin/lxpolkit; do
    if [ -x "$a" ]; then setsid -f "$a" >/dev/null 2>&1; break; fi
  done
fi

# 1b. Dopo un aggiornamento: via i residui della versione vecchia
/usr/libexec/alba/alba-pulizia utente >/dev/null 2>&1

# 2. Prime impostazioni (scorciatoie, sfondo) e aspetto aggiornato
/usr/bin/alba-applica-aspetto --se-serve
/usr/bin/alba-primo-avvio
/usr/bin/alba-segnalibri

# 2a. Leggerezza: "Software" non resta acceso in sottofondo (occupava
#     centinaia di MB). Gli aggiornamenti li controlla Alba da sola.
mkdir -p "$HOME/.config/autostart"
for f in org.gnome.Software.desktop gnome-software-service.desktop; do
  if [ -f "/etc/xdg/autostart/$f" ] && [ ! -f "$HOME/.config/autostart/$f" ]; then
    printf '[Desktop Entry]\nType=Application\nName=Software\nHidden=true\n' > "$HOME/.config/autostart/$f"
    pkill -u "$(id -u)" -f "gnome-software --gapplication-service" 2>/dev/null
  fi
done

# 2a-bis. Icone Fluent sempre attive (se qualcosa le avesse cambiate)
. /usr/share/alba/tema.conf 2>/dev/null
case "$(cat "$CONF/tema" 2>/dev/null)" in chiaro) ICONE_GIUSTE="${ICONE_CHIARO:-}" ;; *) ICONE_GIUSTE="${ICONE_SCURO:-}" ;; esac
if [ -n "$ICONE_GIUSTE" ] && [ -d "/usr/share/icons/$ICONE_GIUSTE" ] && \
   [ "$(xfconf-query -c xsettings -p /Net/IconThemeName 2>/dev/null)" != "$ICONE_GIUSTE" ]; then
  xfconf-query -c xsettings -p /Net/IconThemeName -s "$ICONE_GIUSTE" 2>/dev/null
  gsettings set org.gnome.desktop.interface icon-theme "$ICONE_GIUSTE" 2>/dev/null
fi

# 2a-quater. Leggerezza: programmi che restano accesi senza servire a nessuno
#   - promemoria di Evolution (accende il calendario di GNOME: ~200 MB)
#   - indicizzatore di file Tracker (anche 300-500 MB)
#   - KDE Connect: parte solo se attivi "Telefono" nelle Impostazioni
for f in org.gnome.Evolution-alarm-notify.desktop tracker-miner-fs-3.desktop geoclue-demo-agent.desktop \
         zeitgeist-datahub.desktop org.kde.kdeconnect.daemon.desktop print-applet.desktop; do
  if [ -f "/etc/xdg/autostart/$f" ] && [ ! -f "$HOME/.config/autostart/$f" ]; then
    printf '[Desktop Entry]\nType=Application\nName=%s\nHidden=true\n' "$f" > "$HOME/.config/autostart/$f"
  fi
done
if [ ! -f "$CONF/leggero-v1" ]; then
  systemctl --user mask --now tracker-miner-fs-3.service tracker-extract-3.service \
    evolution-calendar-factory.service evolution-addressbook-factory.service evolution-source-registry.service >/dev/null 2>&1
  pkill -u "$(id -u)" -f "evolution-alarm-notify|evolution-calendar-factory|evolution-addressbook-factory|evolution-source-registry" 2>/dev/null
  touch "$CONF/leggero-v1"
fi

# 2a-ter. "Software" non scarica/installa aggiornamenti per conto suo (li gestisce Alba)
gsettings set org.gnome.software download-updates false 2>/dev/null
gsettings set org.gnome.software download-updates-notify false 2>/dev/null

# 2b. Bluetooth: resta attivo per le associazioni, ma senza icona doppia
#     (c'è già il menu Bluetooth di Alba nella barra)
gsettings set org.blueman.general plugin-list "['!StatusIcon', '!ShowConnected']" 2>/dev/null

# 2c. Grafica senza difetti
#  - senza compositore la barra fluttuante avrebbe i bordi neri: la attacchiamo al bordo
true
#  - NVIDIA che pilota direttamente lo schermo (PC fissi): niente strappi
if [ -e /proc/driver/nvidia/version ] && command -v nvidia-settings >/dev/null && \
   xrandr --listproviders 2>/dev/null | grep -m1 "Provider 0" | grep -qi nvidia; then
  nvidia-settings --assign CurrentMetaMode="nvidia-auto-select +0+0 { ForceFullCompositionPipeline = On }" >/dev/null 2>&1
fi

# 2d. Touchscreen: tastiera sullo schermo che compare quando tocchi un campo di testo
if [ ! -f "$CONF/tastiera-spenta" ] && command -v onboard >/dev/null && \
   xinput list 2>/dev/null | grep -qiE "touch ?screen|finger|ipts|wacom.*touch|elan.*touch"; then
  gsettings set org.onboard.auto-show enabled true 2>/dev/null
  gsettings set org.onboard start-minimized true 2>/dev/null
  gsettings set org.onboard show-status-icon false 2>/dev/null
  gsettings set org.onboard.window docking-enabled true 2>/dev/null
  pgrep -u "$(id -u)" -x onboard >/dev/null || setsid -f onboard >/dev/null 2>&1
fi

# 2e. Modalità gioco automatica (giochi a schermo intero: grafica diretta)
pgrep -u "$(id -u)" -f "bash /usr/bin/alba-modalita-gioco" >/dev/null || setsid -f /usr/bin/alba-modalita-gioco >/dev/null 2>&1

# 3. Risoluzione e frequenza dello schermo scelte nelle Impostazioni
[ -f "$CONF/schermo.sh" ] && bash "$CONF/schermo.sh" >/dev/null 2>&1

# 4. Steam: Proton Experimental predefinito e shader più veloci
/usr/bin/alba-steam >/dev/null 2>&1

# 4b. Aggiornamento di Alba installato da solo: chiede di riavviare
(
  sleep 20
  while true; do /usr/libexec/alba/alba-chiedi-riavvio; sleep 60; done
) >/dev/null 2>&1 &

# 5. Avviso quando ci sono aggiornamenti (controlla ogni 6 ore)
(
  sleep 90
  while true; do
    /usr/bin/alba-avviso-aggiornamenti
    sleep 1800
  done
) >/dev/null 2>&1 &
