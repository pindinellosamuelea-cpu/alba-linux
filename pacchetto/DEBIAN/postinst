#!/bin/sh
# Alba Linux - configurazione del sistema dopo installazione/aggiornamento.
# Ogni passo è "idempotente": si può ripetere senza fare danni.
set -e

LIB=/usr/libexec/alba
STATO=/var/lib/alba
mkdir -p "$STATO"

# Vero se siamo su un sistema avviato (non durante la costruzione dell'ISO)
sistema_avviato() {
  # durante l'aggiornamento al riavvio non si avvia niente (si riavvia subito dopo)
  [ "${ALBA_OFFLINE:-0}" != 1 ] && [ -d /run/systemd/system ] && [ "$(stat -Lc %d:%i / 2>/dev/null)" = "$(stat -Lc %d:%i /proc/1/root 2>/dev/null)" ]
}

# Esegue un passo una sola volta per sistema (rispetta le scelte successive dell'utente)
una_volta() {  # nome
  [ -e "$STATO/fatto-$1" ] && return 1
  touch "$STATO/fatto-$1"
  return 0
}

# Schermata di accesso moderna (se slick-greeter è installato)
configura_accesso() {
  "$LIB/alba-configura-accesso" || true
}

# Firefox: lettori di smart card e CIE riconosciuti nei siti (es. SPID/CIE)
configura_smartcard() {
  MOD=/usr/lib/x86_64-linux-gnu/opensc-pkcs11.so
  POL=/etc/firefox/policies/policies.json
  if [ -f "$MOD" ] && [ ! -e "$POL" ]; then
    mkdir -p /etc/firefox/policies
    cat > "$POL" <<EOF2
{
  "policies": {
    "SecurityDevices": { "Lettore smart card (OpenSC)": "$MOD" }
  }
}
EOF2
  fi
}

case "$1" in
  triggered)
    "$LIB/alba-aggiorna-menu" || true
    configura_accesso
    exit 0 ;;
  configure) ;;
  *) exit 0 ;;
esac

# --- Vecchi percorsi delle versioni precedenti --------------------------------
mkdir -p /usr/local/bin
for f in /usr/bin/alba-*; do
  n="$(basename "$f")"
  [ -e "/usr/local/bin/$n" ] && [ ! -L "/usr/local/bin/$n" ] && rm -f "/usr/local/bin/$n"
  ln -sfn "$f" "/usr/local/bin/$n"
done
ln -sfn /usr/bin/alba-impostazioni /usr/local/bin/alba-data-ora
rm -f /etc/xdg/autostart/alba-primo-avvio.desktop \
      /usr/share/applications/alba-data-ora.desktop

# --- Repository Debian completi (servono per i driver NVIDIA e Steam) --------
# Aggiunge "contrib non-free" alle fonti Debian già presenti, senza creare
# doppioni (che bloccherebbero gli aggiornamenti).
rm -f /etc/apt/sources.list.d/alba-debian-extra.sources
"$LIB/alba-fonti-debian" || echo "Alba: fonti Debian non modificate"

# --- Sicurezza (impostazioni predefinite, applicate una sola volta) ----------
if [ -f /etc/ufw/ufw.conf ] && una_volta firewall; then
  sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
  sed -i 's/^DEFAULT_INPUT_POLICY=.*/DEFAULT_INPUT_POLICY="DROP"/' /etc/default/ufw
  sed -i 's/^DEFAULT_OUTPUT_POLICY=.*/DEFAULT_OUTPUT_POLICY="ACCEPT"/' /etc/default/ufw
  sed -i 's/^DEFAULT_FORWARD_POLICY=.*/DEFAULT_FORWARD_POLICY="DROP"/' /etc/default/ufw
  systemctl enable ufw.service >/dev/null 2>&1 || true
  sistema_avviato && ufw --force enable >/dev/null 2>&1 || true
fi
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
EOF
# Gli aggiornamenti di Alba NON si installano più mentre usi il computer:
# si scaricano e si applicano al riavvio (vedi alba-aggiornamento).
rm -f /etc/apt/apt.conf.d/52alba-unattended
sistema_avviato && systemctl daemon-reload >/dev/null 2>&1 || true
systemctl enable alba-aggiornamento-offline.service >/dev/null 2>&1 || true
# Configurazione iniziale al primo avvio dopo l'installazione (come Windows)
systemctl enable alba-oobe-controlla.service >/dev/null 2>&1 || true
systemctl enable alba-scarica-aggiornamenti.timer >/dev/null 2>&1 || true
sistema_avviato && systemctl start --no-block alba-scarica-aggiornamenti.timer >/dev/null 2>&1 || true
# PackageKit (app "Software") non deve fare aggiornamenti al riavvio per conto suo
systemctl mask packagekit-offline-update.service >/dev/null 2>&1 || true
for s in apparmor clamav-freshclam systemd-timesyncd power-profiles-daemon; do
  systemctl enable "$s.service" >/dev/null 2>&1 || true
done
if una_volta servizi-remoti; then
  systemctl disable ssh.service >/dev/null 2>&1 || true
  systemctl disable cups-browsed.service >/dev/null 2>&1 || true
  systemctl disable docker.service containerd.service >/dev/null 2>&1 || true
  systemctl enable docker.socket >/dev/null 2>&1 || true
fi
if sistema_avviato; then
  sysctl -q --system >/dev/null 2>&1 || true
# audio sempre pronto (vale subito, senza riavvio)
[ -w /sys/module/snd_hda_intel/parameters/power_save ] && echo 0 > /sys/module/snd_hda_intel/parameters/power_save 2>/dev/null || true
  timedatectl set-ntp true >/dev/null 2>&1 || true
fi

# --- RAM compressa (PC con poca memoria) ---------------------------------------
if [ -f /etc/default/zramswap ]; then
  sed -i 's/^#\?PERCENT=.*/PERCENT=50/; s/^#\?ALGO=.*/ALGO=zstd/' /etc/default/zramswap
fi

# --- Aspetto: sfondo, associazioni file, menu ----------------------------------
for f in /usr/share/backgrounds/xfce/xfce-shapes.svg /usr/share/backgrounds/xfce/xfce-x.svg \
         /usr/share/backgrounds/xfce/xfce-verticals.png /usr/share/backgrounds/xfce/xfce-leaves.svg; do
  [ -e "$f" ] && ln -sf /usr/share/backgrounds/alba/alba.png "$f"
done
cp /etc/xdg/mimeapps.list /etc/xdg/xfce-mimeapps.list
"$LIB/alba-aggiorna-menu" || true
update-desktop-database -q /usr/share/applications 2>/dev/null || true
for d in /usr/share/icons/hicolor /usr/share/icons/Fluent /usr/share/icons/Fluent-dark; do
  [ -d "$d" ] && gtk-update-icon-cache -qf "$d" 2>/dev/null || true
done

# --- Avvio: logo Alba e niente menu di GRUB ------------------------------------
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  # la schermata di avvio vive nell'initramfs: va rigenerato se il tema cambia
  FIRMA="$(cat /usr/share/plymouth/themes/alba/* 2>/dev/null | md5sum | cut -c1-32)"
  if [ "$(plymouth-set-default-theme 2>/dev/null)" != "alba" ] || [ "$(cat "$STATO/plymouth-firma" 2>/dev/null)" != "$FIRMA" ]; then
    plymouth-set-default-theme alba || true
    if ls /boot/initrd.img-* >/dev/null 2>&1; then
      update-initramfs -u -k all >/dev/null 2>&1 && echo "$FIRMA" > "$STATO/plymouth-firma" \
        || echo "Alba: aggiornamento initramfs non riuscito"
    fi
  fi
fi
# Niente scritte "Loading Linux…" / "Loading initial ramdisk…" all'accensione:
# solo il logo di Alba che carica.
if [ -f /etc/grub.d/10_linux ] && grep -q "^[[:space:]]*echo[[:space:]]*'\$(echo \"\$message\" | grub_quote)'" /etc/grub.d/10_linux; then
  sed -i "s/^\([[:space:]]*\)echo\([[:space:]]*\)'\$(echo \"\$message\" | grub_quote)'/\1# alba: senza scritte # echo\2'\$(echo \"\$message\" | grub_quote)'/" /etc/grub.d/10_linux
fi
sysctl -q --system >/dev/null 2>&1 || true
if [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null 2>&1; then
  update-grub >/dev/null 2>&1 || echo "Alba: update-grub non riuscito"
fi

configura_accesso
configura_smartcard
systemctl enable pcscd.socket >/dev/null 2>&1 || true

# --- App extra in sottofondo (PeaZip, LocalSend, KDE Connect, Wine recente) ---
systemctl enable alba-extra.service >/dev/null 2>&1 || true
if sistema_avviato; then
  systemctl start --no-block alba-extra.service >/dev/null 2>&1 || true
fi

# --- Risoluzione problemi automatica (ogni 3 ore, ripara solo cose sicure) ---
systemctl enable alba-diagnosi.timer >/dev/null 2>&1 || true
sistema_avviato && systemctl start --no-block alba-diagnosi.timer >/dev/null 2>&1 || true

# --- Grafica senza difetti (sfarfallio Intel, strappi AMD/NVIDIA) -----------
systemctl enable alba-grafica.service >/dev/null 2>&1 || true
"$LIB/alba-grafica" || true
if [ "$(cat "$STATO/grafica-versione" 2>/dev/null)" != "1" ] && ls /boot/initrd.img-* >/dev/null 2>&1; then
  update-initramfs -u -k all >/dev/null 2>&1 || true
  echo 1 > "$STATO/grafica-versione"
fi

# --- Driver grafico automatico (NVIDIA) --------------------------------------
systemctl enable alba-driver-auto.service >/dev/null 2>&1 || true
if sistema_avviato; then
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl start --no-block alba-driver-auto.service >/dev/null 2>&1 || true
fi

# --- Leggerezza: meno programmi sempre accesi (meno RAM a computer fermo) ----
# Docker e la stampa partono solo quando servono davvero (all'uso), non da subito.
if [ "$(cat "$STATO/leggero-versione" 2>/dev/null)" != "1" ]; then
  if systemctl list-unit-files docker.socket >/dev/null 2>&1; then
    systemctl disable docker.service containerd.service >/dev/null 2>&1 || true
    systemctl enable docker.socket >/dev/null 2>&1 || true
  fi
  if systemctl list-unit-files cups.socket >/dev/null 2>&1; then
    systemctl disable cups.service >/dev/null 2>&1 || true
    systemctl enable cups.socket cups.path >/dev/null 2>&1 || true
  fi
  echo 1 > "$STATO/leggero-versione"
fi
if [ "$(cat "$STATO/leggero-versione" 2>/dev/null)" = "1" ]; then
  # winbind serve solo nelle reti aziendali Windows (dominio): spento
  if ! grep -qiE "^[[:space:]]*security[[:space:]]*=[[:space:]]*(ads|domain)" /etc/samba/smb.conf 2>/dev/null; then
    systemctl disable --now winbind.service >/dev/null 2>&1 || true
  fi
  echo 2 > "$STATO/leggero-versione"
fi

# --- Pulizia dei residui delle versioni vecchie --------------------------------
# Ogni aggiornamento riparte pulito: errori vecchi, cache e pacchetti inutili via.
if [ -n "${2:-}" ] && [ "$(cat "$STATO/pulizia-versione" 2>/dev/null)" != "$(cat /usr/share/alba/versione 2>/dev/null)" ]; then
  "$LIB/alba-pulizia" sistema || true
  if sistema_avviato; then
    systemd-run --no-block --quiet --unit="alba-pulizia-$$" "$LIB/alba-pulizia" apt >/dev/null 2>&1 || true
  fi
fi

# --- Dopo un aggiornamento: alla sessione aperta viene chiesto di riavviare ---
# (anche quando l'aggiornamento si è installato da solo in automatico)
if [ -n "${2:-}" ]; then
  # versione + identificativo di QUESTO avvio: dopo un riavvio l'identificativo
  # cambia e la richiesta sparisce da sola (anche se l'orologio è sbagliato)
  if [ "${ALBA_OFFLINE:-0}" = 1 ]; then
    rm -f "$STATO/riavvio-aggiornamento"   # installato al riavvio: il riavvio c'è già
  else
    echo "$(cat /usr/share/alba/versione 2>/dev/null) $(cat /proc/sys/kernel/random/boot_id)" > "$STATO/riavvio-aggiornamento"
  fi
fi

# transizione accesso -> desktop tolta (non piaceva)
rm -f /etc/X11/Xsession.d/95alba-transizione /usr/bin/alba-transizione

# --- Nome e versione ---------------------------------------------------------------
VERSIONE="$(cat /usr/share/alba/versione 2>/dev/null || echo 1)"
cat > /etc/alba-release <<EOF
NAME="Alba Linux"
VERSION="$VERSIONE"
BASE="Debian 13 trixie"
EOF

exit 0
