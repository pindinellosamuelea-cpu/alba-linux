    # -------------------------------------------------------------- fine
    def applica(self):
        self.rotella.start()
        self.riprova.hide()
        l, v, _ = LAYOUT[self.scelte["layout"]]
        dati = {"utente": self.utente.get_text().strip(), "nome": self.nome.get_text().strip(),
                "password": self.password.get_text(), "lingua": self.scelte["lingua"], "layout": l,
                "variante": v, "fuso": self.scelte["fuso"], "tema": self.scelte["tema"]}
        if self.foto_scelta and not PROVA:
            try:
                dest = os.path.join(os.path.expanduser("~"), "foto-account.png")
                quadrata(GdkPixbuf.Pixbuf.new_from_file(self.foto_scelta), 256).savev(dest, "png", [], [])
                os.chmod(dest, 0o644)
                dati["foto"] = dest
            except (GLib.Error, OSError):
                pass

        def lavoro():
            if PROVA:
                time.sleep(2)
                return True, ""
            try:
                r = subprocess.run(["sudo", "-n", "/usr/libexec/alba/alba-oobe-applica"], input=json.dumps(dati),
                                   capture_output=True, text=True, timeout=120)
                return r.returncode == 0, (r.stderr or r.stdout).strip()
            except (OSError, subprocess.TimeoutExpired) as e:
                return False, str(e)

        def fatto(esito):
            ok, dettaglio = esito
            self.rotella.stop()
            if ok:
                nome = dati["nome"].split()[0] if dati["nome"] else ""
                self.titolo_lato.set_text(f"Benvenuto, {nome}!" if nome else "Benvenuto!")
                self.messaggio_fine.set_text("Tutto pronto. Tra un attimo compare la schermata di accesso: "
                                             "entra con la password che hai scelto.")
            else:
                self.messaggio_fine.set_text("Qualcosa non è andato: " + (dettaglio or "errore sconosciuto"))
                self.riprova.show()
        threading.Thread(target=lambda: GLib.idle_add(fatto, lavoro()), daemon=True).start()


