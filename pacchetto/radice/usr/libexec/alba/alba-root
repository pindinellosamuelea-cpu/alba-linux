#!/bin/bash
# Alba Linux - piccole operazioni da amministratore richieste dall'app
# Impostazioni (tramite pkexec, che chiede la password).
# Accetta solo i comandi elencati qui sotto, con argomenti controllati.
set -u
[ "$(id -u)" -eq 0 ] || { echo "Servono i permessi di amministratore" >&2; exit 1; }
export DEBIAN_FRONTEND=noninteractive
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

ARG="${2:-}"
case "${1:-}" in
  aggiorna-lista)
    apt-get update -q
    ;;
  aggiorna-prepara)
    # scarica ora, installa al riavvio (prima dell'accesso)
    /usr/libexec/alba/alba-aggiornamento prepara
    esito=$?
    /usr/libexec/alba/alba-driver-auto --aggiornamento >/dev/null 2>&1
    exit $esito
    ;;
  aggiorna-annulla)
    /usr/libexec/alba/alba-aggiornamento annulla
    ;;
  aggiorna-installa)
    apt-get update -q || true
    apt-get -y -q -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
      --with-new-pkgs upgrade
    esito=$?
    command -v flatpak >/dev/null && flatpak update -y --noninteractive --system >/dev/null 2>&1
    # Driver grafico migliore per questo computer (se serve)
    /usr/libexec/alba/alba-driver-auto --aggiornamento >/dev/null 2>&1
    /usr/libexec/alba/alba-extra >/dev/null 2>&1
    exit $esito
    ;;
  firewall)
    case "$ARG" in
      on)  ufw --force enable ;;
      off) ufw disable ;;
      *) exit 2 ;;
    esac
    ;;
  ntp)
    case "$ARG" in
      on)  timedatectl set-ntp true ;;
      off) timedatectl set-ntp false ;;
      *) exit 2 ;;
    esac
    ;;
  fuso)
    timedatectl list-timezones | grep -qxF -- "$ARG" || exit 2
    timedatectl set-timezone "$ARG"
    ;;
  coperchio)
    # cosa fa la chiusura del coperchio (per tutti, anche prima dell'accesso)
    case "$ARG" in suspend|hibernate|poweroff|ignore) ;; *) exit 2 ;; esac
    mkdir -p /etc/systemd/logind.conf.d
    printf '[Login]\nHandleLidSwitch=%s\nHandleLidSwitchExternalPower=%s\nHandleLidSwitchDocked=ignore\n' \
      "$ARG" "$ARG" > /etc/systemd/logind.conf.d/50-alba.conf
    systemctl kill -s HUP systemd-logind
    ;;
  tastiera)
    # layout della tastiera per tutto il sistema (anche schermata di accesso)
    # ARG = "it" oppure "it,ch" ; VARIANTE in $3 (es. ",fr")
    [[ "$ARG" =~ ^[a-z]{2,3}(,[a-z]{2,3})?$ ]] || exit 2
    VAR="${3:-}"
    [[ "$VAR" =~ ^[a-z_,]*$ ]] || exit 2
    localectl set-x11-keymap "$ARG" pc105 "$VAR" "grp:win_space_toggle" 2>/dev/null || \
      localectl set-x11-keymap "$ARG" pc105 "$VAR"
    ;;
  imposta-ora)
    [[ "$ARG" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}$ ]] || exit 2
    timedatectl set-ntp false
    timedatectl set-time "$ARG:00"
    ;;
  ora-windows)
    case "$ARG" in
      0|1) timedatectl set-local-rtc "$ARG" --adjust-system-clock ;;
      *) exit 2 ;;
    esac
    ;;
  driver)
    exec /usr/libexec/alba/alba-driver-auto --forza
    ;;
  diagnosi)
    exec /usr/libexec/alba/alba-diagnosi --controlla
    ;;
  ripara)
    [[ "$ARG" =~ ^[a-z0-9-]{1,40}$ ]] || exit 2
    exec /usr/libexec/alba/alba-diagnosi --ripara "$ARG"
    ;;
  installa-cie)
    URL=https://github.com/italia/cie-middleware-linux/releases/download/1.4.3.1/CIE-Middleware-1.4.3-2.amd64.deb
    T="$(mktemp -d)"
    curl -fsSL -o "$T/cie.deb" "$URL" || { rm -rf "$T"; exit 4; }
    apt-get update -q || true
    apt-get install -y -q pcscd libccid opensc "$T/cie.deb"
    esito=$?
    rm -rf "$T"
    exit $esito
    ;;
  installa)
    # Solo pacchetti della lista consentita
    case "$ARG" in
      systemd-timesyncd|corectrl|power-profiles-daemon|brightnessctl|mangohud|pcscd|opensc|pcsc-tools|game-devices-udev|steam-devices) ;;
      *) exit 2 ;;
    esac
    apt-get update -q || true
    apt-get install -y -q "$ARG"
    [ "$ARG" = systemd-timesyncd ] && timedatectl set-ntp true
    ;;
  utente-nuovo)
    # Nuovo account. Argomenti: NOME_ACCOUNT standard|amministratore
    # Da stdin: nome completo, password, (facoltativa) foto.
    TIPO="${3:-standard}"
    [[ "$ARG" =~ ^[a-z][a-z0-9_-]{0,30}$ ]] || exit 2
    case "$ARG" in root|albaoobe|lightdm) exit 2 ;; esac
    case "$TIPO" in standard|amministratore) ;; *) exit 2 ;; esac
    id "$ARG" >/dev/null 2>&1 && { echo "Esiste già un account con questo nome" >&2; exit 3; }
    IFS= read -r NOME || exit 2
    IFS= read -r PASS || exit 2
    IFS= read -r FOTO || FOTO=""
    [ -n "$NOME" ] && [ -n "$PASS" ] || exit 2
    case "$NOME" in *:*|*,*|*=*) exit 2 ;; esac
    GRUPPI=""
    for g in audio video plugdev netdev bluetooth lpadmin scanner users input render; do
      getent group "$g" >/dev/null && GRUPPI="$GRUPPI,$g"
    done
    [ "$TIPO" = amministratore ] && GRUPPI="$GRUPPI,sudo"
    useradd -m -s /bin/bash -c "$NOME" -G "${GRUPPI#,}" "$ARG" || exit 4
    printf '%s:%s\n' "$ARG" "$PASS" | chpasswd || exit 4
    /usr/libexec/alba/alba-root utente-foto "$ARG" "$FOTO" >/dev/null 2>&1 || true
    ;;
  utente-foto)
    # Foto di un account (anche di un altro utente): solo immagini vere
    U="$ARG"; FOTO="${3:-}"
    id "$U" >/dev/null 2>&1 || exit 2
    [ -n "$FOTO" ] && [ -f "$FOTO" ] || exit 0
    case "$(file -b --mime-type -- "$FOTO")" in image/*) ;; *) exit 2 ;; esac
    mkdir -p /var/lib/AccountsService/icons /var/lib/AccountsService/users
    install -m 644 -- "$FOTO" "/var/lib/AccountsService/icons/$U"
    F="/var/lib/AccountsService/users/$U"
    if [ -f "$F" ] && grep -q '^Icon=' "$F"; then sed -i "s|^Icon=.*|Icon=/var/lib/AccountsService/icons/$U|" "$F"
    elif [ -f "$F" ]; then sed -i "/^\[User\]/a Icon=/var/lib/AccountsService/icons/$U" "$F"
    else printf '[User]\nIcon=/var/lib/AccountsService/icons/%s\nSystemAccount=false\n' "$U" > "$F"; fi
    systemctl try-restart accounts-daemon >/dev/null 2>&1 || true
    ;;
  *)
    echo "Comando non riconosciuto" >&2
    exit 2
    ;;
esac
