#!/bin/sh
# Alba Linux - configurazione di live-build
# Base: Debian 13 "trixie", 64 bit, con firmware e driver non liberi
# per la massima compatibilità hardware.
set -e

lb config noauto \
  --mode debian \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --parent-archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-chroot "http://deb.debian.org/debian/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --security true \
  --updates true \
  --backports false \
  --linux-packages "linux-image linux-headers" \
  --firmware-binary true \
  --firmware-chroot true \
  --apt-recommends true \
  --debian-installer none \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi syslinux" \
  --uefi-secure-boot enable \
  --chroot-squashfs-compression-type xz \
  --iso-application "Alba Linux" \
  --iso-volume "ALBA_LINUX" \
  --iso-publisher "Alba Linux" \
  --image-name "alba-linux" \
  --bootappend-live "boot=live components quiet splash username=alba hostname=alba locales=it_IT.UTF-8 keyboard-layouts=ch,it keyboard-options=grp:alt_shift_toggle timezone=Europe/Zurich user-default-groups=audio,cdrom,dip,floppy,video,plugdev,netdev,powerdev,scanner,bluetooth,lpadmin,docker,sudo" \
  --bootappend-live-failsafe "boot=live components username=alba hostname=alba locales=it_IT.UTF-8 keyboard-layouts=ch,it timezone=Europe/Zurich nomodeset nosplash" \
  "${@}"
