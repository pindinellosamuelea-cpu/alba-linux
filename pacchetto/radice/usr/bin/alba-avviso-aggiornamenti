#!/bin/bash
# Alba Linux - notifica discreta quando ci sono aggiornamenti da installare.
# Gli elenchi vengono aggiornati ogni giorno dal sistema; gli aggiornamenti
# di sicurezza si installano già da soli.
set -u
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/alba"
mkdir -p "$CONF"

# Riparazioni fatte da sole in sottofondo: avvisa con una notifica chiara
REG=/var/lib/alba/riparazioni.log
if [ -f "$REG" ]; then
  VISTO="$(cat "$CONF/riparazioni-viste" 2>/dev/null || echo 0)"
  python3 - "$REG" "$VISTO" <<'PY' | while IFS='|' read -r ora titolo risolto id; do
import json, sys
for l in open(sys.argv[1]):
    try:
        d = json.loads(l)
    except ValueError:
        continue
    if d.get("ora", 0) > int(sys.argv[2]):
        print(f"{d['ora']}|{d.get('titolo', '')}|{d.get('risolto')}|{d.get('id', '')}")
PY
    if [ "$risolto" = "True" ]; then
      notify-send -a "Alba" -i emblem-ok-symbolic "Ho sistemato un problema" "$titolo: risolto." 2>/dev/null
    elif ! grep -qx "$(date +%F) $id" "$CONF/avvisi-problemi" 2>/dev/null; then
      echo "$(date +%F) $id" >> "$CONF/avvisi-problemi"
      notify-send -a "Alba" -i dialog-warning-symbolic "Problema da controllare" "$titolo. Apri Impostazioni → Risoluzione problemi." 2>/dev/null
    fi
    echo "$ora" > "$CONF/riparazioni-viste"
  done
fi

# Kernel per Surface installato: serve un riavvio
if [ -f /var/lib/alba/surface-riavvio ] && ! uname -r | grep -q surface && \
   [ "$(cat "$CONF/avviso-surface" 2>/dev/null)" != "$(date +%F)" ]; then
  date +%F > "$CONF/avviso-surface"
  TESTO="Riavvia per attivare touchscreen e penna del Surface."
  [ -f /var/lib/alba/surface-mok ] && TESTO="$TESTO Nella schermata blu scegli Enroll MOK → Continue → Yes, password: surface."
  R="$(notify-send -a "Alba" -i input-tablet -A riavvia="Riavvia ora" "Supporto Surface installato" "$TESTO" 2>/dev/null)"
  [ "$R" = "riavvia" ] && systemctl reboot
fi

# Driver NVIDIA installato in automatico: serve un riavvio
if [ -f /var/lib/alba/driver-riavvio ] && [ ! -e /proc/driver/nvidia/version ] && \
   [ "$(cat "$CONF/avviso-driver" 2>/dev/null)" != "$(date +%F)" ]; then
  date +%F > "$CONF/avviso-driver"
  TESTO="Riavvia il computer per attivarlo: giochi e app useranno la scheda al massimo."
  [ -f /var/lib/alba/driver-mok ] && TESTO="$TESTO Al riavvio, nella schermata blu scegli Enroll MOK → Continue → Yes, password: albalinux."
  R="$(notify-send -a "Alba" -i video-display -A riavvia="Riavvia ora" "Driver NVIDIA installato" "$TESTO" 2>/dev/null)"
  [ "$R" = "riavvia" ] && systemctl reboot
elif [ -f /var/lib/alba/driver-secure-boot ] && [ ! -e /proc/driver/nvidia/version ] && \
   [ "$(cat "$CONF/avviso-driver" 2>/dev/null)" != "$(date +%F)" ]; then
  date +%F > "$CONF/avviso-driver"
  R="$(notify-send -a "Alba" -i video-display -A installa="Installa" "Driver NVIDIA consigliato" \
        "Per la tua scheda c'è il driver ufficiale, molto più veloce nei giochi." 2>/dev/null)"
  [ "$R" = "installa" ] && setsid -f /usr/bin/alba-driver-grafici >/dev/null 2>&1
fi

N="$(apt list --upgradable 2>/dev/null | grep -c 'upgradable')"
[ "${N:-0}" -gt 0 ] || exit 0

# Al massimo un avviso al giorno
OGGI="$(date +%F)"
[ "$(cat "$CONF/ultimo-avviso" 2>/dev/null)" = "$OGGI" ] && exit 0
echo "$OGGI" > "$CONF/ultimo-avviso"

if [ "$N" -eq 1 ]; then TESTO="C'è 1 aggiornamento pronto da installare."
else TESTO="Ci sono $N aggiornamenti pronti da installare."; fi

R="$(notify-send -a "Alba" -i system-software-update -A apri="Aggiorna ora" \
      "Aggiornamenti disponibili" "$TESTO" 2>/dev/null)"
[ "$R" = "apri" ] && setsid -f /usr/bin/alba-impostazioni --pagina aggiornamenti >/dev/null 2>&1
exit 0
