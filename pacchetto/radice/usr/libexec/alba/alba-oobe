        self._utente_toccato = False
        self.nome.connect("changed", lambda e: None if self._utente_toccato else
                          self.utente.set_text(nome_utente_da(e.get_text())))
        self.utente.connect("key-press-event", lambda *_: setattr(self, "_utente_toccato", True))
        self.conferma.connect("activate", lambda *_: self.vai(+1))
        for i, (testo, campo) in enumerate((("Il tuo nome", self.nome), ("Nome utente", self.utente),
                                            ("Password", self.password), ("Ripeti la password", self.conferma))):
            griglia.attach(etichetta(testo, "campo"), 0, i * 2, 1, 1)
            campo.set_hexpand(True)
            griglia.attach(campo, 0, i * 2 + 1, 1, 1)
        box.pack_start(griglia, False, False, 4)
        box.pack_start(etichetta("La password serve solo per entrare e per i cambi importanti: Alba non la "
                                 "chiede per aprire i programmi.", "testo", wrap=True), False, False, 4)
        return box

