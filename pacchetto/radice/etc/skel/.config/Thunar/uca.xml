<?xml version="1.0" encoding="UTF-8"?>
<actions>
  <action>
    <icon>video-display</icon>
    <name>Avvia con scheda grafica dedicata</name>
    <submenu></submenu>
    <unique-id>alba-gpu-dedicata-1</unique-id>
    <command>/usr/bin/alba-gpu-dedicata xdg-open %f</command>
    <description>Usa la scheda grafica più potente</description>
    <range>*</range>
    <patterns>*.exe;*.EXE;*.msi;*.MSI;*.AppImage;*.desktop;*.blend;*.kdenlive;*.kra;*.xcf</patterns>
    <other-files/>
  </action>
  <action>
    <icon>utilities-terminal</icon>
    <name>Apri terminale qui</name>
    <submenu></submenu>
    <unique-id>alba-terminale-1</unique-id>
    <command>exo-open --working-directory %f --launch TerminalEmulator</command>
    <description>Apre un terminale in questa cartella</description>
    <range></range>
    <patterns>*</patterns>
    <startup-notify/>
    <directories/>
  </action>
</actions>
