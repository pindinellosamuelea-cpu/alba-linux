#!/bin/bash
# Alba Linux - colori della barra in alto e del Dock (vetro chiaro o scuro).
# Uso: alba-barra [chiaro|scuro] [--vetro on|off]
# Senza tema usa quello scelto in Impostazioni. "fluttuante"/"bordo" (vecchie
# versioni) sono accettati e ignorati.
set -u
export LC_ALL=C   # numeri con il punto (xfconf non capisce "0,980")
CSS="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/gtk.css"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/alba"
mkdir -p "$(dirname "$CSS")" "$CONF"
touch "$CSS"

TEMA="$(cat "$CONF/tema" 2>/dev/null || echo chiaro)"
VETRO="$(cat "$CONF/vetro" 2>/dev/null || echo on)"
while [ $# -gt 0 ]; do
  case "$1" in
    chiaro|scuro) TEMA="$1" ;;
    --vetro) shift; VETRO="${1:-on}" ;;
    fluttuante|bordo) ;;
    *) echo "Uso: alba-barra [chiaro|scuro] [--vetro on|off]"; exit 1 ;;
  esac
  shift
done
echo "$VETRO" > "$CONF/vetro"

# trasparenza: con il vetro spento le barre sono piene
if [ "$VETRO" = off ]; then A_BARRA=1; A_DOCK=1; else A_BARRA=0.72; A_DOCK=0.58; fi
if [ "$TEMA" = scuro ]; then
  RGB_BARRA="30 28 36"; RGB_DOCK="34 32 42"
  BARRA="rgba(30,28,36,$A_BARRA)"; DOCK="rgba(34,32,42,$A_DOCK)"; TESTO="#f3eee8"
  LINEA="rgba(255,255,255,0.08)"; RIFLESSO="rgba(255,255,255,0.12)"
  SOPRA="rgba(255,255,255,0.10)"; PREMUTO="rgba(255,255,255,0.16)"
else
  RGB_BARRA="250 246 242"; RGB_DOCK="255 251 247"
  BARRA="rgba(250,246,242,$A_BARRA)"; DOCK="rgba(255,251,247,$A_DOCK)"; TESTO="#2a2018"
  LINEA="rgba(120,80,40,0.10)"; RIFLESSO="rgba(255,255,255,0.75)"
  SOPRA="rgba(60,30,0,0.07)"; PREMUTO="rgba(240,122,30,0.18)"
fi

# Togli la versione precedente del blocco Alba (lascia intatto il resto)
sed -i '/ALBA-BARRA-INIZIO/,/ALBA-BARRA-FINE \*\//d' "$CSS"
sed -e "s/@BARRA@/$BARRA/g; s/@DOCK@/$DOCK/g; s/@TESTO@/$TESTO/g; s/@LINEA@/$LINEA/g" \
    -e "s/@RIFLESSO@/$RIFLESSO/g; s/@SOPRA@/$SOPRA/g; s/@PREMUTO@/$PREMUTO/g" \
    /usr/share/alba/css/barre.css >> "$CSS"

imposta() { xfconf-query -c "$1" -p "$2" -n -t "$3" -s "$4" 2>/dev/null || xfconf-query -c "$1" -p "$2" -s "$4" 2>/dev/null; }
# Colore di vetro anche via xfconf: così le icone della barra e del Dock (che
# girano in finestre a parte) ricevono esattamente lo stesso sfondo.
colore() {  # pannello "r g b" alfa
  set -- "$1" $2 "$3"
  local r g b
  r="$(awk "BEGIN{printf \"%.3f\", $2/255}")"; g="$(awk "BEGIN{printf \"%.3f\", $3/255}")"; b="$(awk "BEGIN{printf \"%.3f\", $4/255}")"
  imposta xfce4-panel "/panels/$1/background-style" uint 1
  xfconf-query -c xfce4-panel -p "/panels/$1/background-rgba" -n -t double -s "$r" -t double -s "$g" -t double -s "$b" -t double -s "$5" 2>/dev/null || \
    xfconf-query -c xfce4-panel -p "/panels/$1/background-rgba" -t double -s "$r" -t double -s "$g" -t double -s "$b" -t double -s "$5" 2>/dev/null
}
colore panel-1 "$RGB_BARRA" "$A_BARRA"
colore panel-2 "$RGB_DOCK" "$A_DOCK"
imposta xfce4-panel /panels/dark-mode bool "$([ "$TEMA" = scuro ] && echo true || echo false)"

/usr/libexec/alba/alba-dock-posiziona >/dev/null 2>&1
[ -z "${XFCE_PANEL_NO_RESTART:-}" ] && pgrep -u "$(id -u)" -x xfce4-panel >/dev/null && { xfce4-panel -r >/dev/null 2>&1 & }
exit 0
