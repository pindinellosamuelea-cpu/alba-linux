    def controllo():
        conf = leggi("/etc/ufw/ufw.conf")
        if conf and "ENABLED=yes" not in conf:
            return True, "il firewall è disattivato"
        return False, ""

    @staticmethod
    def ripara():
        esegui(["ufw", "--force", "enable"])


@problema("memoria", "Memoria compressa non attiva",
          "Sui computer con poca RAM la memoria compressa evita rallentamenti e blocchi.", auto=True, gravita="bassa")
class Memoria:
    @staticmethod
    def controllo():
        if not os.path.exists("/etc/default/zramswap"):
            return False, ""
        if "zram" not in esegui(["swapon", "--show"])[1]:
            return True, "la memoria compressa è spenta"
        return False, ""

    @staticmethod
    def ripara():
        esegui(["systemctl", "enable", "--now", "zramswap"], 60)


@problema("aggiornamenti", "Aggiornamenti fermi da molti giorni",
          "Il sistema non controlla gli aggiornamenti da più di una settimana.", auto=True, gravita="bassa")
class Aggiornamenti:
    @staticmethod
    def controllo():
        segno = "/var/lib/apt/periodic/update-success-stamp"
        riferimento = segno if os.path.exists(segno) else "/var/lib/apt/lists"
        try:
            giorni = (time.time() - os.path.getmtime(riferimento)) / 86400
        except OSError:
            return False, ""
        return (True, f"ultimo controllo {int(giorni)} giorni fa") if giorni > 7 else (False, "")

    @staticmethod
    def ripara():
        esegui(["apt-get", "update", "-q"], 600)
        esegui(["touch", "/var/lib/apt/periodic/update-success-stamp"])


@problema("bluetooth", "Bluetooth bloccato",
          "Il Bluetooth è bloccato dal sistema: cuffie, mouse e controller non si collegano.", gravita="media")
class Bluetooth:
    @staticmethod
    def controllo():
