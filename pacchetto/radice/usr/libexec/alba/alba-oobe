    def cerca_reti(self):
        self.stato_rete.set_text("Cerco le reti vicine…")

        def leggi():
            if PROVA:
                return False, [("CasaMia", 92, "WPA2"), ("Vodafone-5G", 70, "WPA2"), ("Ospiti", 41, "")]
            _, att = esegui(["nmcli", "-t", "-f", "TYPE,STATE", "device"])
            cavo = any(l.startswith("ethernet:connected") for l in att.splitlines())
            _, out = esegui(["nmcli", "-t", "-e", "no", "-f", "SSID,SIGNAL,SECURITY", "device", "wifi", "list",
                             "--rescan", "yes"], timeout=25)
            reti = {}
            for l in out.splitlines():
                p = l.rsplit(":", 2)
                if len(p) == 3 and p[0] and (p[0] not in reti or int(p[1] or 0) > reti[p[0]][1]):
                    reti[p[0]] = (p[0], int(p[1] or 0), p[2])
            return cavo, sorted(reti.values(), key=lambda r: -r[1])

        def mostra(r):
            cavo, reti = r
            for c in self.lista_reti.get_children():
                self.lista_reti.remove(c)
            if cavo:
                self.connesso = True
                self.stato_rete.set_text("Sei già collegato a Internet con il cavo. ✓")
                self.avanti.set_label("Avanti")
            else:
                self.stato_rete.set_text("Tocca una rete per collegarti." if reti else "Nessuna rete trovata.")
            for ssid, segnale, sicurezza in reti[:20]:
                riga = Gtk.ListBoxRow()
                riga.rete = (ssid, sicurezza)
                b = Gtk.Box(spacing=10)
                liv = "excellent" if segnale > 75 else "good" if segnale > 50 else "ok" if segnale > 25 else "weak"
                b.pack_start(Gtk.Image.new_from_icon_name(f"network-wireless-signal-{liv}-symbolic",
                                                          Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
                n = etichetta(ssid)
                n.set_ellipsize(Pango.EllipsizeMode.END)
                b.pack_start(n, True, True, 0)
                if sicurezza:
                    b.pack_end(Gtk.Image.new_from_icon_name("changes-prevent-symbolic", Gtk.IconSize.MENU),
                               False, False, 0)
                riga.add(b)
                self.lista_reti.add(riga)
            self.lista_reti.show_all()
