class Foto(Gtk.DrawingArea):
    """Foto dell'utente in un cerchio (o l'iniziale su un cerchio arancione)."""

    def __init__(self, utente, lato):
        super().__init__()
        self.lato = lato
        self.set_size_request(lato, lato)
        self.immagine = None
        self.iniziale = (utente.get_display_name() or utente.get_name() or "?")[:1].upper()
        percorso = utente.get_image() if hasattr(utente, "get_image") else ""
        for p in (percorso, os.path.expanduser(f"~{utente.get_name()}/.face")):
            if p and ("debian" in os.path.realpath(p) or "desktop-base" in os.path.realpath(p)):
                continue   # niente logo di Debian come foto
            if p and os.path.isfile(p):
                try:
                    self.immagine = GdkPixbuf.Pixbuf.new_from_file_at_scale(p, lato, lato, False)
                    break
                except GLib.Error:
                    pass
        self.connect("draw", self.disegna)

    def disegna(self, _w, cr):
        l = self.lato
        cr.arc(l / 2, l / 2, l / 2, 0, 2 * math.pi)
        if self.immagine:
            cr.save()
            cr.clip()
            Gdk.cairo_set_source_pixbuf(cr, self.immagine, 0, 0)
            cr.paint()
            cr.restore()
        else:
            g = __import__("cairo").LinearGradient(0, 0, l, l)
            g.add_color_stop_rgb(0, 1.0, 0.62, 0.35)
            g.add_color_stop_rgb(1, 0.86, 0.32, 0.38)
            cr.set_source(g)
            cr.fill()
            cr.set_source_rgb(1, 1, 1)
            cr.select_font_face("Inter", 0, 1)
            cr.set_font_size(l * 0.42)
            e = cr.text_extents(self.iniziale)
            cr.move_to(l / 2 - e.width / 2 - e.x_bearing, l / 2 - e.height / 2 - e.y_bearing)
            cr.show_text(self.iniziale)
        # anello sottile
        cr.new_path()
        cr.arc(l / 2, l / 2, l / 2 - 1, 0, 2 * math.pi)
        cr.set_source_rgba(1, 1, 1, 0.35)
        cr.set_line_width(2)
        cr.stroke()


class Sfondo(Gtk.DrawingArea):
    def __init__(self):
        super().__init__()
        self.originale = None
        self.scalato = None
        self.zoom = 1.0
        self.nitido = None        # sfondo del desktop dell'utente (passaggio finale)
        self.nitido_scalato = None
        self.misto = 0.0          # 0 = sfondo sfocato dell'accesso, 1 = desktop
        try:
            self.originale = GdkPixbuf.Pixbuf.new_from_file(SFONDO)
        except GLib.Error:
            pass
        self.connect("draw", self.disegna)

    @staticmethod
    def copri(pix, L, A):
        s = max(L / pix.get_width(), A / pix.get_height())
        return pix.scale_simple(max(1, int(pix.get_width() * s)), max(1, int(pix.get_height() * s)),
                                GdkPixbuf.InterpType.BILINEAR)

    def disegna(self, w, cr):
        L, A = w.get_allocated_width(), w.get_allocated_height()
        if self.originale:
            if not self.scalato or self.scalato.get_width() < L or self.scalato.get_height() < A:
                o = self.originale
                s = max(L / o.get_width(), A / o.get_height())
                self.scalato = o.scale_simple(max(1, int(o.get_width() * s)), max(1, int(o.get_height() * s)),
                                              GdkPixbuf.InterpType.BILINEAR)
            cr.save()
            if self.zoom != 1.0:   # leggero zoom all'apertura, centrato
                cr.translate(L / 2, A / 2)
                cr.scale(self.zoom, self.zoom)
                cr.translate(-L / 2, -A / 2)
            Gdk.cairo_set_source_pixbuf(cr, self.scalato, (L - self.scalato.get_width()) / 2,
                                        (A - self.scalato.get_height()) / 2)
            cr.paint()
            cr.restore()
        else:
            cr.set_source_rgb(0.04, 0.06, 0.16)
            cr.paint()
        # velo scuro per leggere bene i testi (sparisce verso il desktop)
        cr.set_source_rgba(0.02, 0.03, 0.08, 0.30 * (1 - self.misto))
        cr.paint()
        # passaggio al desktop: lo sfondo sfocato diventa quello nitido dell'utente
        if self.nitido and self.misto > 0:
            if not self.nitido_scalato or self.nitido_scalato.get_width() < L or self.nitido_scalato.get_height() < A:
                self.nitido_scalato = self.copri(self.nitido, L, A)
            Gdk.cairo_set_source_pixbuf(cr, self.nitido_scalato, (L - self.nitido_scalato.get_width()) / 2,
                                        (A - self.nitido_scalato.get_height()) / 2)
            cr.paint_with_alpha(self.misto)


class Accesso:
    def __init__(self):
        self.esito = 0
        self.greeter = None
        self.utente = None
        self.in_corso = False
        if not PROVA:
            self.greeter = LightDM.Greeter()
            self.greeter.connect("show-prompt", self.chiede)
            self.greeter.connect("show-message", self.messaggio_pam)
            self.greeter.connect("authentication-complete", self.completato)
            self.greeter.connect_to_daemon_sync()
            self.utenti = [u for u in LightDM.UserList.get_instance().get_users()]
        else:
            self.utenti = [UtenteFinto("ale", "Alessandro"), UtenteFinto("ospite", "Ospite")]

        impostazioni = Gtk.Settings.get_default()
        conf = tema()
        impostazioni.set_property("gtk-theme-name", conf.get("TEMA_SCURO", "Adwaita-dark"))
        impostazioni.set_property("gtk-icon-theme-name", conf.get("ICONE_SCURO", "Adwaita"))
        impostazioni.set_property("gtk-application-prefer-dark-theme", True)
        impostazioni.set_property("gtk-font-name", "Inter 11")
        stile = Gtk.CssProvider()
        stile.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), stile,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 10)

        schermo = Gdk.Display.get_default()
        principale = schermo.get_primary_monitor() or schermo.get_monitor(0)
        self.finestre = []
        self.sfondi = []
        for i in range(schermo.get_n_monitors()):
            m = schermo.get_monitor(i)
            self.finestre.append(self.crea_finestra(m.get_geometry(), m == principale))

        self.scegli_utente(self.utente_iniziale(), animazione=False)
        self.entrata()
        if PROVA and "--prova-ingresso" in sys.argv:   # per le foto di prova
            GLib.timeout_add(1500, lambda: (self.uscita(Gtk.main_quit), False)[1])

    # ------------------------------------------------------------ interfaccia
    def crea_finestra(self, g, principale):
        f = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        f.set_decorated(False)
        f.move(g.x, g.y)
        f.set_default_size(g.width, g.height)
        f.set_size_request(g.width, g.height)
        sovrapposto = Gtk.Overlay()
        sfondo = Sfondo()
        self.sfondi.append(sfondo)
        sovrapposto.add(sfondo)
        f.add(sovrapposto)
        f.realize()
        f.get_window().set_cursor(Gdk.Cursor.new_from_name(Gdk.Display.get_default(), "default"))
        if principale:
            self.costruisci(sovrapposto, g)
            f.connect("key-press-event", self.tasto)
        f.show_all()
        return f

