#!/usr/bin/python3
"""Alba Linux - barra in alto: tiene aggiornato il nome del programma in
primo piano (accanto al logo di Alba).

Fa anche due piccoli lavori di fondo, senza consumare:
 - rimette il Dock al suo posto quando lo schermo cambia (risoluzione, monitor);
 - tema automatico: chiaro di giorno, scuro dal tramonto all'alba (se scelto).

Non controlla di continuo: aspetta che il sistema segnali un cambio di
finestra (xprop -spy), scrive il nome e chiede alla barra di ridisegnarlo.
"""
import math
import os
import re
import subprocess
import sys
import threading
import time
from datetime import datetime, timedelta, timezone

from gi.repository import Gio

FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "alba-app-attiva")
SCRIVANIA = "Scrivania"
# finestre che non cambiano il nome (la barra stessa, il Dock, la griglia...)
IGNORA = {"xfce4-panel", "wrapper-2.0", "plank", "alba-app", "alba-rapido", "alba-osd",
          "xfce4-notifyd", "alba-menu-x", "xfce4-screenshooter"}
NOMI_FISSI = {"xfdesktop": SCRIVANIA, "thunar": "File", "alba-impostazioni": "Impostazioni",
              "alba-gestione-attivita": "Gestione attività"}


def nomi_app():
    d = {}
    for a in Gio.AppInfo.get_all():
        if not isinstance(a, Gio.DesktopAppInfo):
            continue
        nome = a.get_display_name() or a.get_name()
        if not nome:
            continue
        chiavi = [(a.get_id() or "").removesuffix(".desktop")]
        wm = a.get_startup_wm_class()
        if wm:
            chiavi.append(wm)
        exe = a.get_executable()
        if exe:
            chiavi.append(os.path.basename(exe))
        for k in chiavi:
            k = k.lower()
            if k:
                d.setdefault(k, nome)
                d.setdefault(k.split(".")[-1], nome)   # org.gnome.Software -> software
    return d


def xprop(*a):
    try:
        return subprocess.run(["xprop", *a], capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def plugin_genmon():
    out = subprocess.run(["xfconf-query", "-c", "xfce4-panel", "-l", "-v"], capture_output=True, text=True).stdout
    for riga in out.splitlines():
        m = re.match(r"/plugins/(plugin-\d+)/command\s+alba-icona app\s*$", riga)
        if m:
            return m.group(1).replace("plugin-", "genmon-")
    return None


CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "alba")


def posiziona_dock():
    subprocess.run(["/usr/libexec/alba/alba-dock-posiziona"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def spia_schermo():
    """Il Dock torna al centro quando cambia lo schermo (anche all'avvio)."""
    time.sleep(4)          # la barra ha appena finito di partire
    posiziona_dock()
    try:
        spia = subprocess.Popen(["xprop", "-spy", "-root", "_NET_DESKTOP_GEOMETRY"],
                                stdout=subprocess.PIPE, text=True)
        primo = True
        for _riga in spia.stdout:
            if primo:       # la prima riga è lo stato attuale
                primo = False
                continue
            time.sleep(1)
            posiziona_dock()
    except OSError:
        pass


def coordinate():
    try:
        tz = os.path.realpath("/etc/localtime").split("zoneinfo/")[-1]
        for riga in open("/usr/share/zoneinfo/zone1970.tab", encoding="utf-8"):
            parti = riga.split("\t")
            if len(parti) >= 3 and parti[2].strip() == tz:
                m = re.match(r"([+-])(\d{2})(\d{2})(\d{0,2})([+-])(\d{3})(\d{2})(\d{0,2})", parti[1])
                if m:
                    lat = (int(m[2]) + int(m[3]) / 60) * (1 if m[1] == "+" else -1)
                    lon = (int(m[6]) + int(m[7]) / 60) * (1 if m[5] == "+" else -1)
                    return lat, lon
    except OSError:
        pass
    return 46.0, 9.0       # nord Italia / Ticino


def alba_tramonto(giorno, lat, lon):
    """Ora (UTC) di alba e tramonto: formula semplice, precisa a qualche minuto."""
    n = giorno.timetuple().tm_yday
    gamma = 2 * math.pi / 365 * (n - 1)
    eq = 229.18 * (0.000075 + 0.001868 * math.cos(gamma) - 0.032077 * math.sin(gamma)
                   - 0.014615 * math.cos(2 * gamma) - 0.040849 * math.sin(2 * gamma))
    decl = (0.006918 - 0.399912 * math.cos(gamma) + 0.070257 * math.sin(gamma) - 0.006758 * math.cos(2 * gamma)
            + 0.000907 * math.sin(2 * gamma) - 0.002697 * math.cos(3 * gamma) + 0.00148 * math.sin(3 * gamma))
    phi = math.radians(lat)
    c = (math.cos(math.radians(90.833)) / (math.cos(phi) * math.cos(decl)) - math.tan(phi) * math.tan(decl))
    c = max(-1.0, min(1.0, c))
    ha = math.degrees(math.acos(c))
    mezzanotte = datetime(giorno.year, giorno.month, giorno.day, tzinfo=timezone.utc)
    alba = mezzanotte + timedelta(minutes=720 - 4 * (lon + ha) - eq)
    tramonto = mezzanotte + timedelta(minutes=720 - 4 * (lon - ha) - eq)
    return alba, tramonto


def tema_automatico():
    """Con "Automatico" scelto in Impostazioni: chiaro di giorno, scuro di sera."""
    while True:
        if os.path.exists(os.path.join(CONF, "tema-automatico")):
            voluto = tema_di_adesso()
            try:
                attuale = open(os.path.join(CONF, "tema")).read().strip()
            except OSError:
                attuale = "chiaro"
            if attuale != voluto:
                subprocess.run(["/usr/bin/alba-tema", voluto], env=dict(os.environ, ALBA_TEMA_AUTO="1"),
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(120)


def main():
    threading.Thread(target=spia_schermo, daemon=True).start()
    threading.Thread(target=tema_automatico, daemon=True).start()
    app = nomi_app()
    genmon = plugin_genmon()
    ultimo = None

    def scrivi(nome):
        nonlocal ultimo
        if nome == ultimo:
            return
        ultimo = nome
        with open(FILE + ".tmp", "w") as f:
            f.write(nome)
        os.replace(FILE + ".tmp", FILE)
        if genmon:
            subprocess.Popen(["xfce4-panel", f"--plugin-event={genmon}:refresh:bool:true"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def nome_finestra(wid):
        if wid in ("0x0", ""):
            return SCRIVANIA
        classe = re.findall(r'"([^"]*)"', xprop("-id", wid, "WM_CLASS"))
        if not classe:
            return SCRIVANIA
        candidati = [c.lower() for c in reversed(classe)]
        if any(c in IGNORA for c in candidati):
            return None
        for c in candidati:
            if c in NOMI_FISSI:
                return NOMI_FISSI[c]
        for c in candidati:
            if c in app:
                return app[c]
            if c.endswith(".exe"):          # programmi Windows
                return c[:-4].capitalize()
        titolo = re.findall(r'= "(.*)"', xprop("-id", wid, "_NET_WM_NAME"))
        nome = classe[-1] or (titolo[0] if titolo else SCRIVANIA)
        return nome[:1].upper() + nome[1:]

    scrivi(SCRIVANIA)
    spia = subprocess.Popen(["xprop", "-spy", "-root", "_NET_ACTIVE_WINDOW"],
                            stdout=subprocess.PIPE, text=True)
    for riga in spia.stdout:
        m = re.search(r"window id # (0x[0-9a-f]+)", riga)
        nome = nome_finestra(m.group(1) if m else "0x0")
        if nome:
            scrivi(nome)
    return spia.wait()


def tema_di_adesso():
    lat, lon = coordinate()
    ora = datetime.now(timezone.utc)
    alba, tramonto = alba_tramonto(ora.date(), lat, lon)
    return "chiaro" if alba <= ora < tramonto else "scuro"


if __name__ == "__main__":
    if "--tema-adesso" in sys.argv:     # usato da Impostazioni → Aspetto → Automatico
        print(tema_di_adesso())
        sys.exit(0)
    sys.exit(main())
