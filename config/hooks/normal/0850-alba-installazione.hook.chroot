#!/bin/sh
# Alba Linux - installazione "come Windows":
#  - l'installer usa il marchio Alba ed è a tutto schermo
#  - niente creazione dell'utente durante l'installazione: lo fai al primo
#    avvio, nella Configurazione iniziale (lingua, Wi-Fi, account, ora, aspetto)
#  - alla fine riavvia da solo
set -e
S=/etc/calamares/settings.conf
[ -f "$S" ] || S=/usr/share/calamares/settings.conf
if [ ! -f "$S" ]; then
  echo "ATTENZIONE: settings.conf di Calamares non trovato"; exit 0
fi
cp "$S" "$S.debian"
python3 - "$S" <<'PY'
import re, sys
p = sys.argv[1]
s = open(p).read()
orig = s
# 1. niente pagina "Utenti" né creazione utente (la fa la Configurazione iniziale)
s = re.sub(r"(?m)^[ \t]*-[ \t]*users[ \t]*\n", "", s)
s = re.sub(r"(\[[^\]\n]*?)\busers\b,?\s*", r"\1", s)
# 1-bis. Meno passaggi (1.2): niente fuso orario né tastiera nell'installer.
# La lingua si sceglie nella prima pagina; fuso, tastiera, account e foto
# arrivano dopo, nella Configurazione iniziale con la grafica di Alba.
for m in ("locale", "keyboard", "localecfg"):
    s = re.sub(rf"(?m)^[ \t]*-[ \t]*{m}[ \t]*\n", "", s)
    s = re.sub(rf"(\[[^\]\n]*?)\b{m}\b,?\s*", r"\1", s)
# 2. marchio Alba
if re.search(r"(?m)^branding:", s):
    s = re.sub(r"(?m)^branding:.*$", "branding: alba", s)
else:
    s += "\nbranding: alba\n"
open(p, "w").write(s)
print("settings.conf: utenti, fuso e tastiera tolti" if s != orig else "settings.conf: nessuna modifica")
print(s)
PY
grep -n "users\|branding" "$S" || true

mkdir -p /etc/calamares/modules
# Avvio: copia anche il percorso di riserva EFI/BOOT/BOOTX64.EFI, così il computer
# parte anche se il firmware non accetta di salvare la voce di avvio (es. Mac T2)
B=/etc/calamares/modules/bootloader.conf
[ -f "$B" ] || B=/usr/share/calamares/modules/bootloader.conf
if [ -f "$B" ]; then
  if grep -q "^installEFIFallback:" "$B"; then
    sed -i 's/^installEFIFallback:.*/installEFIFallback: true/' "$B"
  else
    echo "installEFIFallback: true" >> "$B"
  fi
  grep -n "installEFIFallback\|efiBootloaderId" "$B" || true
fi
# Lo script di Debian che installa il programma di avvio: non deve fallire se
# il pacchetto è già presente o se manca Internet
H=/usr/share/calamares/helpers/calamares-bootloader-config
if [ -f "$H" ] && [ ! -f "$H.debian" ]; then
  echo "== $H (originale)"; cat "$H"
  mv "$H" "$H.debian"
  cat > "$H" <<'EOW'
#!/bin/sh
# Alba Linux: se il programma di avvio è già nel sistema copiato dalla
# chiavetta non serve scaricarlo; altrimenti si usa lo script di Debian.
CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")
echo "Running bootloader-config (Alba)..."
if [ -n "$CHROOT" ] && [ -d /sys/firmware/efi/efivars ] && \
   chroot "$CHROOT" dpkg-query -W -f='${Status}' grub-efi-amd64 2>/dev/null | grep -q "ok installed"; then
  echo " * grub-efi (uefi) già presente: niente da scaricare"
  exit 0
fi
exec /bin/sh /usr/share/calamares/helpers/calamares-bootloader-config.debian "$@"
EOW
  chmod +x "$H"
fi
cat > /etc/calamares/modules/finished.conf <<'EOC'
---
restartNowMode: always
restartNowCommand: "systemctl -i reboot"
notifyOnFinished: false
EOC
# icona "Installa" sul desktop della sessione di prova non serve più
rm -f /etc/skel/Desktop/install-debian.desktop /etc/skel/Scrivania/install-debian.desktop 2>/dev/null || true
exit 0
