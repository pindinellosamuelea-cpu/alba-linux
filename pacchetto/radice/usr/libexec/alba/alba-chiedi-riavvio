#!/bin/bash
# Alba Linux - se Alba si è aggiornata (anche da sola, in automatico) e il
# computer non è ancora stato riavviato, chiede il riavvio con il conto alla
# rovescia. Leggerissimo: controlla solo un file.
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/alba"
M=/var/lib/alba/riavvio-aggiornamento
[ -f "$M" ] || exit 0
[ "$(cat "$M")" = "$(cat "$CONF/riavvio-visto" 2>/dev/null)" ] && exit 0
# già riavviato dopo l'aggiornamento? (l'identificativo dell'avvio è cambiato)
read -r _ AVVIO_AGG < "$M"
if [ "${AVVIO_AGG:-}" != "$(cat /proc/sys/kernel/random/boot_id)" ]; then
  mkdir -p "$CONF"; cat "$M" > "$CONF/riavvio-visto"
  exit 0
fi
fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 && exit 0     # sta ancora installando
pgrep -u "$(id -u)" -f "notify-send -a Alba-riavvio" >/dev/null && exit 0
# un solo avviso pulito (niente finestre in più); una volta per aggiornamento
mkdir -p "$CONF"; cat "$M" > "$CONF/riavvio-visto"
R="$(notify-send -a Alba-riavvio -i system-software-update -A riavvia="Riavvia ora" \
      "Alba è stata aggiornata" "Riavvia quando vuoi per completare." 2>/dev/null)"
[ "$R" = "riavvia" ] && systemctl reboot
exit 0
